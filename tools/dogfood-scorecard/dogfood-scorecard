def _run_start(run):
    return parse_ts(run.get("started_at") or run.get("created_at"))


def _card_identifier(entry):
    if isinstance(entry, str):
        return entry.strip(), ""
    ident = (entry or {}).get("identifier")
    if not isinstance(ident, str) or not ident.strip():
        raise ScorecardError("cards.json entry without identifier: %r" % (entry,))
    return ident.strip(), (entry.get("note") or "")


def load_cards(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except OSError as exc:
        raise ScorecardError("cannot read %s: %s" % (path, exc))
    except ValueError as exc:
        raise ScorecardError("%s is not valid json: %s" % (path, exc))
    entries = data.get("cards") if isinstance(data, dict) else data
    if not isinstance(entries, list) or not entries:
        raise ScorecardError("%s has no cards[]" % path)
    cards = []
    seen = set()
    for entry in entries:
        ident, note = _card_identifier(entry)
        if ident in seen:
            raise ScorecardError("duplicate card %s in %s" % (ident, path))
        seen.add(ident)
        cards.append({"identifier": ident, "note": note})
    return cards


def _empty_card(identifier, note):
    return {
        "identifier": identifier,
        "note": note,
        "issue_id": None,
        "title": None,
        "resolved": False,
        "runs": {
            "total": 0,
            "completed": 0,
            "failed": 0,
            "blocked": 0,
            "cancelled": 0,
            "open": 0,
            "retried": 0,
            "after_delegated_failure": 0,
        },
        "tokens": {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "models": []},
        "cost": {
            "scope": "card-lifetime",
            "cost_usd_ticks": None,
            "metered_task_count": None,
            "task_count": None,
            "unreported_task_count": None,
        },
        "memory_inject": {
            "runs_with_report": 0,
            "runs_without_report": 0,
            "tokens_total": 0,
            "tokens_mean": None,
        },
        "memory_tools": {"calls": 0, "by_tool": {}, "runs_with_calls": 0, "runs_unavailable": 0},
        "owner_latency": {
            "samples": 0,
            "median_seconds": None,
            "mean_seconds": None,
            "max_seconds": None,
            "pairs": [],
        },
        "errors": [],
    }


def _memory_tokens(run):
    """(measured, tokens) from result.init_context; measured False when absent."""
    result = run.get("result") or {}
    ctx = result.get("init_context") or {}
    parts = ctx.get("parts")
    if not isinstance(parts, list) or not parts:
        return False, None
    for part in parts:
        if part.get("part") == MEMORY_PART:
            tokens = part.get("tokens")
            if isinstance(tokens, (int, float)):
                return True, int(tokens)
            return False, None
    return False, None


def memory_tool_name(tool):
    """Canonical MOCT memory tool name, or None.

    Mirrors `memoryToolName` in server/internal/handler/moct_memory_tools.go:
    the bare name, or the MCP-qualified `mcp__moct__<name>` form (the server
    segment must contain "moct"). The transcript stores whatever the harness
    called, so both forms occur in practice.
    """
    name = (tool or "").strip()
    if name in MEMORY_TOOLS:
        return name
    qualified = name[len("mcp__"):] if name.startswith("mcp__") else name
    server, sep, rest = qualified.partition("__")
    if sep and "moct" in server.lower() and rest in MEMORY_TOOLS:
        return rest
    return None


def _memory_calls(messages):
    calls = 0
    by_tool = {}
    for msg in messages or []:
        if msg.get("type") != "tool_use":
            continue
        name = memory_tool_name(msg.get("tool"))
        if name:
            calls += 1
            by_tool[name] = by_tool.get(name, 0) + 1
    return calls, by_tool


def _owner_events(source, key, window, errors):
    """Member answers inside the window: comments and answered questions."""
    events = []
    try:
        comments = source.comments(key)
    except SourceError as exc:
        errors.append(str(exc))
        comments = []
    for comment in comments:
        if comment.get("author_type") != "member":
            continue
        at = parse_ts(comment.get("created_at"))
        if window.contains(at):
            events.append({"at": at, "kind": "comment", "id": comment.get("id")})
    try:
        questions = source.questions(key)
    except SourceError as exc:
        errors.append(str(exc))
        questions = []
    for question in questions:
        if question.get("answered_by_type") != "member":
            continue
        at = parse_ts(question.get("answered_at"))
        if window.contains(at):
            events.append({"at": at, "kind": "question", "id": question.get("id")})
    events.sort(key=lambda e: (e["at"], e["kind"], e["id"] or ""))
    return events


def _latency(source, key, window, runs, errors):
    events = _owner_events(source, key, window, errors)
    starts = sorted(
        dt for dt in (_run_start(run) for run in runs) if dt is not None
    )
    pairs = []
    for event in events:
        nxt = next((dt for dt in starts if dt > event["at"]), None)
        if nxt is None:
            continue
        pairs.append(
            {
                "kind": event["kind"],
                "answered_at": iso(event["at"]),
                "run_started_at": iso(nxt),
                "seconds": int((nxt - event["at"]).total_seconds()),
            }
        )
    seconds = [pair["seconds"] for pair in pairs]
    return {
        "samples": len(seconds),
        "median_seconds": round(statistics.median(seconds), 1) if seconds else None,
        "mean_seconds": round(sum(seconds) / len(seconds), 1) if seconds else None,
        "max_seconds": max(seconds) if seconds else None,
        "pairs": pairs[:20],
        "_seconds": seconds,
    }


def summarize_card(source, card, window):
    out = _empty_card(card["identifier"], card["note"])
    errors = out["errors"]
    key = card["identifier"]

    try:
        issue = source.issue(key) or {}
        out["resolved"] = True
        out["issue_id"] = issue.get("id")
        out["title"] = issue.get("title")
    except SourceError as exc:
        errors.append(str(exc))
        return out

    try:
        runs = source.runs(key)
    except SourceError as exc:
        errors.append(str(exc))
        runs = []
    if not isinstance(runs, list):
        errors.append("issue runs: unexpected payload")
        runs = []

    in_window = [run for run in runs if window.contains(_run_start(run))]
    in_window.sort(key=lambda run: (iso(_run_start(run)), run.get("id") or ""))

    models = set()
    memory_reported = 0
    memory_missing = 0
    memory_total = 0
    calls_total = 0
    calls_by_tool = {}
    runs_with_calls = 0
    messages_unavailable = 0

    for run in in_window:
        status = run.get("status")
        out["runs"]["total"] += 1
        if status == TERMINAL_OK:
            out["runs"]["completed"] += 1
        elif status == "failed":
            out["runs"]["failed"] += 1
        elif status == "blocked":
            out["runs"]["blocked"] += 1
        elif status == "cancelled":
            out["runs"]["cancelled"] += 1
        else:
            out["runs"]["open"] += 1
        if isinstance(run.get("attempt"), int) and run["attempt"] > 1:
            out["runs"]["retried"] += 1
        if run.get("trigger_evidence_kind") == "delegated_failure":
            out["runs"]["after_delegated_failure"] += 1

        for row in run.get("usage") or []:
            if not isinstance(row, dict):
                continue
            out["tokens"]["input"] += int(row.get("input_tokens") or 0)
            out["tokens"]["output"] += int(row.get("output_tokens") or 0)
            out["tokens"]["cache_read"] += int(row.get("cache_read_tokens") or 0)
            out["tokens"]["cache_write"] += int(row.get("cache_write_tokens") or 0)
            if row.get("model"):
                models.add(str(row["model"]))

        measured, tokens = _memory_tokens(run)
        if measured:
            memory_reported += 1
            memory_total += tokens
        else:
            memory_missing += 1

        try:
            messages = source.run_messages(key, run.get("id"))
        except SourceError as exc:
            errors.append(str(exc))
            messages_unavailable += 1
            continue
        calls, by_tool = _memory_calls(messages)
        calls_total += calls
        if calls:
            runs_with_calls += 1
            for tool, count in by_tool.items():
                calls_by_tool[tool] = calls_by_tool.get(tool, 0) + count

    out["tokens"]["models"] = sorted(models)
    out["memory_inject"] = {
        "runs_with_report": memory_reported,
        "runs_without_report": memory_missing,
        "tokens_total": memory_total,
        "tokens_mean": round(memory_total / memory_reported, 1) if memory_reported else None,
    }
    out["memory_tools"] = {
        "calls": calls_total,
        "by_tool": dict(sorted(calls_by_tool.items())),
        "runs_with_calls": runs_with_calls,
        "runs_unavailable": messages_unavailable,
    }

    try:
        usage = source.usage(key) or {}
        out["cost"] = {
            "scope": "card-lifetime",
            "cost_usd_ticks": usage.get("cost_usd_ticks"),
            "metered_task_count": usage.get("metered_task_count"),
            "task_count": usage.get("task_count"),
            "unreported_task_count": usage.get("unreported_task_count"),
        }
    except SourceError as exc:
        errors.append(str(exc))

    out["owner_latency"] = _latency(source, key, window, runs, errors)
    out["_latency_seconds"] = out["owner_latency"].pop("_seconds", [])

    # Deterministic order of the error list; the set is stable for a given input.
    out["errors"] = sorted(set(errors))
    out["_agent_runs"] = [(run.get("agent_id"), run.get("id")) for run in in_window]
    return out


def _agent_table(agent_runs, agents_raw):
    index = {}
    for agent in agents_raw or []:
        if agent.get("id"):
            index[agent["id"]] = agent
    counts = {}
    for agent_id, _run_id in agent_runs:
        if not agent_id:
            continue
        counts[agent_id] = counts.get(agent_id, 0) + 1
    rows = []
    for agent_id, runs in counts.items():
        agent = index.get(agent_id) or {}
        subtype = agent.get("subtype") or "unknown"
        rows.append(
            {
                "id": agent_id,
                "name": agent.get("name") or "(unlisted agent)",
                "subtype": subtype,
                "archived": bool(agent.get("archived_at")),
                "runs": runs,
            }
        )
    rows.sort(key=lambda row: (row["name"], row["id"]))
    roles = sum(1 for row in rows if row["subtype"] == "role")
    named = sum(1 for row in rows if row["subtype"] == "agent")
    return {
        "active": len(rows),
        "roles": roles,
        "named": named,
        "unknown": len(rows) - roles - named,
        "list": rows,
    }


def _totals(cards):
    tokens = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0}
    runs = {
        "total": 0,
        "completed": 0,
        "failed": 0,
        "blocked": 0,
        "cancelled": 0,
        "open": 0,
        "retried": 0,
        "after_delegated_failure": 0,
    }
    memory_tokens = 0
    memory_calls = 0
    seconds = []
    for card in cards:
        for key in tokens:
            tokens[key] += card["tokens"][key]
        for key in runs:
            runs[key] += card["runs"][key]
        memory_tokens += card["memory_inject"]["tokens_total"]
        memory_calls += card["memory_tools"]["calls"]
        seconds.extend(card["_latency_seconds"])
    return {
        "runs": runs,
        "tokens": tokens,
        "memory_inject_tokens": memory_tokens,
        "memory_tool_calls": memory_calls,
        "owner_latency": {
            "samples": len(seconds),
            "median_seconds": round(statistics.median(seconds), 1) if seconds else None,
            "mean_seconds": round(sum(seconds) / len(seconds), 1) if seconds else None,
            "max_seconds": max(seconds) if seconds else None,
        },
    }


def build_report(source, cards, window):
    summaries = []
    agent_runs = []
    for card in cards:
        summary = summarize_card(source, card, window)
        agent_runs.extend(summary.pop("_agent_runs", []))
        summaries.append(summary)
    totals = _totals(summaries)
    for summary in summaries:
        summary.pop("_latency_seconds", None)
    try:
        agents_raw = source.agents()
    except SourceError:
        agents_raw = []
    return {
        "tool": TOOL,
        "version": VERSION,
        "window": window.to_json(),
        "cards": summaries,
        "totals": totals,
        "agents": _agent_table(agent_runs, agents_raw),
        "unavailable": UNAVAILABLE,
    }


