#!/usr/bin/env python3
"""dogfood-scorecard — M-577 (M-574 A1): dog-food MMX baseline report.

One read-only pass over a fixed, checked-in card set (`cards.json`). Writes a
deterministic JSON report plus a short markdown table to
`/mnt/workspace/dogfood-scorecard/scorecard-<date>.{json,md}` and prints the
table. Run it once a day; the week of files is the baseline every later M-574
slice is compared against.

Read-only contract (M-577 brief):
  * every number comes from the `multica` CLI (or a pre-captured fixture);
  * no DB access, no writes to the board, no comments, no status changes;
  * a metric with no read path is reported in `unavailable[]` with the missing
    field/endpoint — never estimated, never priced locally.

Sources per metric (also in README.md):
  runs / status / attempt        `multica issue runs <card> --output json`
  tokens in/out/cache            same call, `runs[].usage[]`
  MOCT inject size               same call, `runs[].result.init_context.parts[]`
                                 where `part == "memory"` -> `tokens`
  memory-tool calls              `multica issue run-messages <run> --issue <card>`
                                 rows `type == "tool_use"`, `tool` in
                                 memory_search|memory_get|memory_note
  owner-answer -> next run       `multica issue comment list` (member rows) and
                                 `multica question list` (`answered_at`,
                                 `answered_by_type`) x `runs[].started_at`
  active agents, role vs named   distinct `runs[].agent_id` + `multica agent list`
                                 (`subtype` == role | agent)
  cost                           `multica issue usage <card>` — CARD-LIFETIME,
                                 not windowed; see `unavailable[]`

Usage:
  dogfood-scorecard [--date YYYY-MM-DD | --since RFC3339 [--until RFC3339]]
                    [--cards cards.json] [--out-dir DIR] [--stdout]
                    [--fixture captured.json]

Exit codes: 0 report written, 2 bad usage / unreadable input.
"""

import argparse
import json
import os
import re
import statistics
import subprocess
import sys
from datetime import datetime, timedelta, timezone

TOOL = "dogfood-scorecard"
VERSION = 1
DEFAULT_OUT_DIR = "/mnt/workspace/dogfood-scorecard"
MAX_WINDOW_DAYS = 31  # one run-messages call per run; keep a window bounded
MEMORY_TOOLS = ("memory_get", "memory_note", "memory_search")
MEMORY_PART = "memory"
TERMINAL_OK = "completed"
TERMINAL_BAD = ("failed", "blocked", "cancelled")
HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_CARDS = os.path.join(HERE, "cards.json")

UNAVAILABLE = [
    {
        "metric": "cost_per_card_window",
        "scope": "card-set",
        "missing": "runs[].usage[].cost_usd_ticks",
        "reason": (
            "the runs API drops the per-row task_usage.cost_usd_ticks column, "
            "and `multica issue usage` is card-lifetime only; the report carries "
            "lifetime cost labelled scope=card-lifetime instead of pricing tokens"
        ),
    },
    {
        "metric": "active_agents_workspace",
        "scope": "workspace",
        "missing": "workspace-wide runs listing",
        "reason": (
            "the CLI lists runs per issue; the active-agent count is therefore "
            "scoped to the fixed card set"
        ),
    },
]

_FRAC = re.compile(r"\.(\d+)")
_DAY = re.compile(r"^\d{4}-\d{2}-\d{2}$")


class ScorecardError(Exception):
    """Bad input: usage error, unreadable cards file, oversized window."""


class SourceError(Exception):
    """One CLI read failed. Carried per metric so one bad card cannot kill the day."""

    def __init__(self, what, code):
        super().__init__("%s: exit %s" % (what, code))
        self.what = what
        self.code = code


# --------------------------------------------------------------------------- #
# time helpers — every timestamp is normalised to UTC, second precision
# --------------------------------------------------------------------------- #

def parse_ts(value):
    """RFC3339 (Z or offset, any fraction length) -> aware UTC datetime.

    Sub-second precision is dropped: every reported delta is a whole number of
    seconds, and the baseline should not drift on Go's nanosecond timestamps.
    """
    if not value:
        return None
    s = str(value).strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    m = _FRAC.search(s)
    if m and len(m.group(1)) > 6:
        s = s[: m.start(1)] + m.group(1)[:6] + s[m.end(1):]
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc).replace(microsecond=0)


def iso(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class Window:
    def __init__(self, since, until):
        self.since = since
        self.until = until

    def contains(self, dt):
        return dt is not None and self.since <= dt < self.until

    def label(self):
        return self.since.strftime("%Y-%m-%d")

    def to_json(self):
        seconds = int((self.until - self.since).total_seconds())
        return {
            "since": iso(self.since),
            "until": iso(self.until),
            "seconds": seconds,
            "days": round(seconds / 86400.0, 3),
        }


def resolve_window(date, since, until, now=None):
    if date and (since or until):
        raise ScorecardError("--date cannot be combined with --since/--until")
    if date:
        if not _DAY.match(date):
            raise ScorecardError("--date must be YYYY-MM-DD")
        start = datetime.strptime(date, "%Y-%m-%d").replace(tzinfo=timezone.utc)
        win = Window(start, start + timedelta(days=1))
    elif since:
        start = parse_ts(since)
        if start is None:
            raise ScorecardError("--since must be RFC3339")
        end = parse_ts(until) if until else start + timedelta(days=1)
        if end is None:
            raise ScorecardError("--until must be RFC3339")
        win = Window(start, end)
    elif until:
        raise ScorecardError("--until needs --since")
    else:
        current = now or datetime.now(timezone.utc)
        start = current.replace(hour=0, minute=0, second=0, microsecond=0)
        win = Window(start, start + timedelta(days=1))
    if win.until <= win.since:
        raise ScorecardError("--until must be after --since")
    if (win.until - win.since) > timedelta(days=MAX_WINDOW_DAYS):
        raise ScorecardError("window longer than %d days" % MAX_WINDOW_DAYS)
    return win


