def _num(value):
    if value is None:
        return "—"
    if isinstance(value, int):
        return "{:,}".format(value)
    return str(value)


def render_markdown(report):
    window = report["window"]
    lines = [
        "# Dog-food scorecard — %s" % window["since"][:10],
        "",
        "Window: `%s` → `%s` (%s day(s), UTC)" % (window["since"], window["until"], window["days"]),
        "",
        "| Card | Runs | Failed | Retried | In | Out | Cache read | Mem tok | Mem calls | Owner→run s |",
        "| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
    ]
    for card in report["cards"]:
        runs = card["runs"]
        latency = card["owner_latency"]["median_seconds"]
        ident = card["identifier"] if card["resolved"] else card["identifier"] + " (unresolved)"
        lines.append(
            "| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |"
            % (
                ident,
                _num(runs["total"]),
                _num(runs["failed"]),
                _num(runs["retried"]),
                _num(card["tokens"]["input"]),
                _num(card["tokens"]["output"]),
                _num(card["tokens"]["cache_read"]),
                _num(card["memory_inject"]["tokens_total"]),
                _num(card["memory_tools"]["calls"]),
                _num(latency),
            )
        )
    totals = report["totals"]
    lines.append(
        "| **total** | %s | %s | %s | %s | %s | %s | %s | %s | %s |"
        % (
            _num(totals["runs"]["total"]),
            _num(totals["runs"]["failed"]),
            _num(totals["runs"]["retried"]),
            _num(totals["tokens"]["input"]),
            _num(totals["tokens"]["output"]),
            _num(totals["tokens"]["cache_read"]),
            _num(totals["memory_inject_tokens"]),
            _num(totals["memory_tool_calls"]),
            _num(totals["owner_latency"]["median_seconds"]),
        )
    )
    agents = report["agents"]
    lines += [
        "",
        "Agents active in the window: %d (%d role, %d named, %d unknown), scoped to the card set."
        % (agents["active"], agents["roles"], agents["named"], agents["unknown"]),
        "",
        "Unavailable (named, not estimated):",
    ]
    for gap in report["unavailable"]:
        lines.append("- `%s` — missing `%s` (%s)" % (gap["metric"], gap["missing"], gap["reason"]))
    errors = [(card["identifier"], err) for card in report["cards"] for err in card["errors"]]
    if errors:
        lines += ["", "Read errors:"]
        for ident, err in errors:
            lines.append("- %s: %s" % (ident, err))
    lines.append("")
    return "\n".join(lines)


def write_outputs(report, markdown, out_dir):
    os.makedirs(out_dir, exist_ok=True)
    stem = os.path.join(out_dir, "scorecard-" + report["window"]["since"][:10])
    payload = json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    with open(stem + ".json", "w", encoding="utf-8") as handle:
        handle.write(payload)
    with open(stem + ".md", "w", encoding="utf-8") as handle:
        handle.write(markdown)
    return stem + ".json", stem + ".md"


# --------------------------------------------------------------------------- #
# entry point
# --------------------------------------------------------------------------- #

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=TOOL,
        description="Read-only daily dog-food report over a fixed card set (M-577).",
    )
    parser.add_argument("--cards", default=DEFAULT_CARDS, help="cards.json path")
    parser.add_argument("--date", help="UTC day YYYY-MM-DD (default: today)")
    parser.add_argument("--since", help="RFC3339 window start (needs --until or defaults to +1 day)")
    parser.add_argument("--until", help="RFC3339 window end (exclusive)")
    parser.add_argument("--out-dir", default=DEFAULT_OUT_DIR, help="report directory")
    parser.add_argument("--fixture", help="replay captured CLI payloads (offline test)")
    parser.add_argument("--cli", help="multica executable (default: $MULTICA_CLI_PATH)")
    parser.add_argument("--stdout", action="store_true", help="print JSON instead of the table")
    args = parser.parse_args(argv)

    try:
        window = resolve_window(args.date, args.since, args.until)
        cards = load_cards(args.cards)
    except ScorecardError as exc:
        print("%s: %s" % (TOOL, exc), file=sys.stderr)
        return 2

    if args.fixture:
        try:
            with open(args.fixture, "r", encoding="utf-8") as handle:
                source = FixtureSource(json.load(handle))
        except (OSError, ValueError) as exc:
            print("%s: cannot read fixture: %s" % (TOOL, exc), file=sys.stderr)
            return 2
    else:
        source = CliSource(args.cli)

    report = build_report(source, cards, window)
    markdown = render_markdown(report)
    json_path, md_path = write_outputs(report, markdown, args.out_dir)

    if args.stdout:
        sys.stdout.write(json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False) + "\n")
    else:
        sys.stdout.write(markdown)
        print("wrote %s" % json_path, file=sys.stderr)
        print("wrote %s" % md_path, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
