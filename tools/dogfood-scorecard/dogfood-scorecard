class CliSource:
    """Reads through the multica CLI. No curl, no DB, no writes."""

    def __init__(self, cli=None):
        self.cli = cli or os.environ.get("MULTICA_CLI_PATH") or "multica"

    def _json(self, what, args):
        try:
            proc = subprocess.run(
                [self.cli] + args, capture_output=True, text=True, check=False
            )
        except OSError as exc:
            raise SourceError(what, "spawn:%s" % exc.errno)
        if proc.returncode != 0:
            raise SourceError(what, proc.returncode)
        text = proc.stdout.strip()
        if not text:
            return None
        try:
            return json.loads(text)
        except ValueError:
            raise SourceError(what + " (bad json)", proc.returncode)

    def issue(self, key):
        return self._json("issue get", ["issue", "get", key, "--output", "json"])

    def runs(self, key):
        return self._json("issue runs", ["issue", "runs", key, "--output", "json"]) or []

    def usage(self, key):
        return self._json("issue usage", ["issue", "usage", key, "--output", "json"])

    def comments(self, key):
        return self._json(
            "issue comment list", ["issue", "comment", "list", key, "--output", "json"]
        ) or []

    def questions(self, key):
        return self._json("question list", ["question", "list", key, "--output", "json"]) or []

    def run_messages(self, key, run_id):
        return self._json(
            "issue run-messages",
            ["issue", "run-messages", run_id, "--issue", key, "--output", "json"],
        ) or []

    def agents(self):
        return self._json("agent list", ["agent", "list", "--output", "json"]) or []


class FixtureSource:
    """Offline replay of captured CLI payloads; used by the seeded test."""

    def __init__(self, data):
        self.data = data or {}

    def _one(self, bucket, key):
        value = (self.data.get(bucket) or {}).get(key)
        if value is None:
            raise SourceError(bucket + " " + key, "fixture-miss")
        return value

    def issue(self, key):
        return self._one("issues", key)

    def runs(self, key):
        return self._one("runs", key)

    def usage(self, key):
        return self._one("usage", key)

    def comments(self, key):
        return self._one("comments", key)

    def questions(self, key):
        return self._one("questions", key)

    def run_messages(self, key, run_id):
        return (self.data.get("run_messages") or {}).get(run_id, [])

    def agents(self):
        return self.data.get("agents") or []


