def _parse_ts(value):
    if not value:
        return None
    s = str(value).strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def creation_week(value):
    dt = _parse_ts(value)
    if dt is None:
        return "unknown"
    iso_year, iso_week, _ = dt.isocalendar()
    return "%04d-W%02d" % (iso_year, iso_week)


class CliSource:
    """Reads through the multica CLI. No curl, no DB, no writes."""

    def __init__(self, cli=None):
        self.cli = cli or os.environ.get("MULTICA_CLI_PATH") or "multica"

    def _json(self, what, args):
        try:
            proc = subprocess.run(
                [self.cli] + args, capture_output=True, text=True, check=False
            )
        except OSError as exc:
            raise SourceError(what, "spawn:%s" % exc.errno)
        if proc.returncode != 0:
            raise SourceError(what, proc.returncode)
        text = proc.stdout.strip()
        if not text:
            return None
        try:
            return json.loads(text)
        except ValueError:
            raise SourceError(what + " (bad json)", proc.returncode)

    def issues(self):
        out, offset = [], 0
        while True:
            page = self._json(
                "issue list",
                [
                    "issue", "list", "--output", "json", "--resolve-properties",
                    "--fields", ISSUE_FIELDS, "--limit", str(PAGE),
                    "--offset", str(offset),
                ],
            )
            if not page:
                break
            rows = page.get("issues") or []
            out.extend(rows)
            offset += len(rows)
            if not page.get("has_more") or not rows:
                break
        return out

    def properties(self):
        return self._json("property list", ["property", "list", "--output", "json"]) or []

    def agents(self):
        return self._json("agent list", ["agent", "list", "--output", "json"]) or []


class FixtureSource:
