def _table(headers, rows):
    lines = ["| " + " | ".join(headers) + " |",
             "| " + " | ".join("---" for _ in headers) + " |"]
    for row in rows:
        lines.append("| " + " | ".join(str(cell) for cell in row) + " |")
    return "\n".join(lines)


def render_markdown(report):
    out = ["# Tier-pick data audit — %s" % report["generated_for"], ""]
    out.append("Read path: %s. Total issues: %d. No LLM, no writes." % (
        report["scope"]["read_path"], report["scope"]["total_issues"]))
    out.append("")

    cov = report["coverage"]
    out.append("## Coverage (difficulty fields)")
    out.append("")
    out.append(_table(
        ["group", "count", "percent"],
        [[key, cov["counts"][key], "%s%%" % cov["percent"][key]]
         for key in ("both", "important_only", "complexity_only", "neither")],
    ))
    out.append("")
    out.append("By status:")
    out.append("")
    out.append(_table(
        ["status", "total", "both", "important only", "complexity only", "neither"],
        [[status, sum(b.values()), b["both"], b["important_only"],
          b["complexity_only"], b["neither"]]
         for status, b in cov["by_status"].items()],
    ))
    out.append("")
    out.append("By creation week:")
    out.append("")
    out.append(_table(
        ["week", "total", "both", "important only", "complexity only", "neither"],
        [[week, sum(b.values()), b["both"], b["important_only"],
          b["complexity_only"], b["neither"]]
         for week, b in cov["by_creation_week"].items()],
    ))
    out.append("")

    out.append("## Value distribution (of the values that exist)")
    out.append("")
    out.append(_table(
        ["field", "set", "1", "2", "3", "4", "5"],
        [[name, d["set_count"]] + [d["values"][str(i)] for i in range(1, 6)]
         for name, d in report["value_distribution"].items()],
    ))
    out.append("")

    rf = report["resolver_floor"]
    out.append("## Resolver quality floor")
    out.append("")
    out.append("`%s` (source: `%s`). `%s`" % (
        rf["formula"], rf["source"], rf["note"]))
    out.append("")
    out.append(_table(
        ["scenario", "important", "complexity", "engineer", "management", "architect"],
        [[name, s["important_level"], s["complexity"],
          s["pilot_floors"]["engineer"], s["pilot_floors"]["management"],
          s["pilot_floors"]["architect"]]
         for name, s in rf["scenarios"].items()],
    ))
    out.append("")
    out.append("Sample of %d real cards (required floor, not the concrete tier):" % rf["sample_size"])
    out.append("")
    out.append(_table(
        ["card", "status", "agent role", "today imp/cplx", "today eng/mgt/arch",
         "3/3 eng/mgt/arch", "5/5 eng/mgt/arch"],
        [[row["identifier"], row["status"], row["agent_tier_role"] or "-",
          "%d/%d" % (row["today"]["important_level"], row["today"]["complexity"]),
          "/".join(str(row["today"]["floor_by_role"][r]) for r in PILOT_ROLES),
          "/".join(str(row["fabricated_3"][r]) for r in PILOT_ROLES),
          "/".join(str(row["fabricated_5"][r]) for r in PILOT_ROLES)]
         for row in rf["sample"]],
    ))
    out.append("")

    out.append("## Unavailable (no CLI read path — stopped on these parts)")
    out.append("")
    out.append(_table(
        ["metric", "missing", "reason"],
        [[u["metric"], u["missing"], u["reason"]] for u in report["unavailable"]],
    ))
    out.append("")

    prop = report["proposal"]
    out.append("## Proposal (not applied)")
    out.append("")
    out.append(prop["question"])
    out.append("")
    out.append(prop["evidence"])
    out.append("")
    out.append(_table(
        ["option", "name", "pros", "cons"],
        [[o["id"], o["name"], "; ".join(o["pros"]), "; ".join(o["cons"])]
         for o in prop["options"]],
    ))
    out.append("")
    out.append("Recommendation: **%s** — %s" % (
        prop["recommendation"], prop["recommendation_detail"]))
    out.append("")

    bf = report["backfill"]
    out.append("## Backfill (%s)" % bf["mode"])
    out.append("")
    if bf["mode"] == "dry-run":
        out.append("Would touch %d open/new cards; %d closed cards excluded. "
                   "Writes performed: %s." % (
                       bf["eligible_count"], bf["excluded_closed_count"],
                       bf["writes_performed"]))
        out.append("")
        out.append("Rules: " + "; ".join(bf["rules"]))
        out.append("")
        out.append("Deferred signals: " + "; ".join(bf["deferred_signals"]))
        out.append("")
        out.append(_table(
            ["card", "status", "current imp/cplx", "would set imp/cplx"],
            [[p["identifier"], p["status"],
              "%d/%d" % (p["current"]["important_level"], p["current"]["complexity"]),
              "%d/%d" % (p["would_set"]["important_level"], p["would_set"]["complexity"])]
             for p in bf["plan"][:20]],
        ))
        if bf["eligible_count"] > 20:
            out.append("")
            out.append("(%d more rows in the JSON report.)" % (bf["eligible_count"] - 20))
    else:
        out.append("No backfill run; pass `--dry-run` to see the proposed writes.")
    return "\n".join(out) + "\n"


def write_outputs(report, markdown, out_dir):
    os.makedirs(out_dir, exist_ok=True)
    stem = os.path.join(out_dir, "tier-pick-audit-" + report["generated_for"])
    payload = json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    with open(stem + ".json", "w", encoding="utf-8") as handle:
        handle.write(payload)
    with open(stem + ".md", "w", encoding="utf-8") as handle:
        handle.write(markdown)
    return stem + ".json", stem + ".md"


# --------------------------------------------------------------------------- #
# entry point
# --------------------------------------------------------------------------- #

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=TOOL,
        description="Read-only audit of the tier-pick inputs (M-588 B4).",
    )
    parser.add_argument("--date", help="UTC day YYYY-MM-DD (default: today)")
    parser.add_argument("--out-dir", default=DEFAULT_OUT_DIR, help="report directory")
    parser.add_argument("--fixture", help="replay captured CLI payloads (offline test)")
    parser.add_argument("--cli", help="multica executable (default: $MULTICA_CLI_PATH)")
    parser.add_argument("--stdout", action="store_true", help="print JSON instead of the table")
    parser.add_argument("--dry-run", action="store_true",
                        help="show the proposed backfill writes; never applies them")
    args = parser.parse_args(argv)

    day = args.date or datetime.now(timezone.utc).strftime("%Y-%m-%d")
    try:
        datetime.strptime(day, "%Y-%m-%d")
    except ValueError:
        print("%s: --date must be YYYY-MM-DD" % TOOL, file=sys.stderr)
        return 2

    if args.fixture:
        try:
            with open(args.fixture, "r", encoding="utf-8") as handle:
                source = FixtureSource(json.load(handle))
        except (OSError, ValueError) as exc:
            print("%s: cannot read fixture: %s" % (TOOL, exc), file=sys.stderr)
            return 2
    else:
        source = CliSource(args.cli)

    try:
        report = build_report(source, day, dry_run=args.dry_run)
    except (AuditError, SourceError) as exc:
        print("%s: %s" % (TOOL, exc), file=sys.stderr)
        return 2

    markdown = render_markdown(report)
    json_path, md_path = write_outputs(report, markdown, args.out_dir)
    if args.stdout:
        sys.stdout.write(json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False) + "\n")
    else:
        sys.stdout.write(markdown)
        print("wrote %s" % json_path, file=sys.stderr)
        print("wrote %s" % md_path, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
