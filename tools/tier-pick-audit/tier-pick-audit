# --------------------------------------------------------------------------- #
# difficulty + resolver floor — mirrors multica-x tier_resolve.go exactly
# --------------------------------------------------------------------------- #

def prop_level(raw):
    """tierPropLevel: a JSON number in 1..5 that is integral; anything else -> 1."""
    if raw is None:
        return 1
    try:
        value = float(raw)
    except (TypeError, ValueError):
        return 1
    if value != math.trunc(value) or value < 1 or value > 5:
        return 1
    return int(value)


def difficulty(issue):
    """difficultyFromProperties over the CLI's --resolve-properties rows."""
    bag = {}
    for row in issue.get("properties") or []:
        name = str(row.get("name") or "").strip().lower()
        if name in DIFFICULTY:
            bag[name] = row.get("value")
    return prop_level(bag.get("important_level")), prop_level(bag.get("complexity"))


def normalize_role(role):
    key = (role or "").strip().lower()
    return ROLE_ALIASES.get(key, key)


def required_quality(role, important, complex_level):
    """requiredTierQuality: lo + ceil((hi-lo)*(important+complex-2)/8)."""
    band = TIER_QUALITY_BANDS.get(normalize_role(role))
    if not band:
        return 0
    lo, hi = band
    return lo + int(math.ceil(float(hi - lo) * float(important + complex_level - 2) / 8.0))


def pilot_floors(important, complex_level):
    """The required floor for each of the three roles the M-588 pilot uses."""
    return {role: required_quality(role, important, complex_level) for role in PILOT_ROLES}


def scenario_floors(important, complex_level):
    """Floors for all bands plus the three pilot roles, for one difficulty."""
    all_bands = {}
    for role in sorted(TIER_QUALITY_BANDS):
        all_bands[role] = required_quality(role, important, complex_level)
    return {
        "important_level": important,
        "complexity": complex_level,
        "floor_by_role": all_bands,
        "pilot_floors": pilot_floors(important, complex_level),
    }


