class AuditError(Exception):
    """Bad input: usage error or unreadable fixture."""


class SourceError(Exception):
    """One CLI read failed; carried per source so one failure is visible."""

    def __init__(self, what, code):
        super().__init__("%s: exit %s" % (what, code))
        self.what = what
        self.code = code


