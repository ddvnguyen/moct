def fetch_status_page(status, limit=100, offset=0):
    d = sh_json(["multica", "issue", "list", "--output", "json", "--status", status,
                 "--fields", "identifier,id,status,assignee_id,updated_at,last_activity_at,priority,title",
                 "--limit", str(limit), "--offset", str(offset)])
