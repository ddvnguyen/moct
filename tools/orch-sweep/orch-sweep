    return m


def row_state(row, t):
    """ok | cooling | expired(cooldown needs clearing) | unknown — based on cooldown_until vs now"""
    if row.get("cooldown_until"):
        u = parse_ts(row["cooldown_until"])
        if u and u > t:
            return "cooling"
        return "cooldown-expired"
    return row.get("state", "unknown")


def seed_ledger(applied):
    size = len(json.dumps(DEFAULT_LEDGER))
    assert size < 4000, f"default ledger too big: {size}"
    rc, out, err = sh(["multica", "issue", "metadata", "set", M86_ID, "--key", LEDGER_KEY,
                       "--value", json.dumps(DEFAULT_LEDGER, separators=(",", ":"), ensure_ascii=False),
                       "--type", "string"])
    applied["seeded"] = rc == 0
    applied["bytes"] = size
    if rc != 0:
        applied["error"] = err.strip()[:200]


# -------------------------------------------------------------------- board
def sweep(ledger, names, all_prs, apply_cooldown, max_cards, max_runs_err_len=260):
    t_start = now()
    issues_d = fetch_issues()
    if isinstance(issues_d, list):
        issues = issues_d
    else:
        issues = issues_d.get("issues", [])
    # note: one list call per status; page covers the small managed board.
    # has_more=True would need deeper pagination later — the tick report prints
    # counts so nothing truncates silently.

    in_prog = [i for i in issues if i.get("status") == "in_progress"]
    planing = [i for i in issues if i.get("status") == "planing_2"]
    todos = [i for i in issues if i.get("status") == "todo" and i.get("assignee_id")]

    # WIP per agent over in_progress cards
    wip = {}
    for i in in_prog:
        wip[i.get("assignee_id")] = wip.get(i.get("assignee_id"), 0) + 1

    agent_row = ledger_row_agents(ledger) if ledger else {}

    selected = sorted(in_prog, key=lambda x: x.get("last_activity_at") or "")
    if max_cards:
        selected = selected[:max_cards]

    board, checked = [], 0
    sig_detections = {}
    tcache, chcache = {}, {}  # M-284 r1: target-issue statuses, children statuses
    for i in selected:
        key = i.get("identifier")
        runs = card_runs(i["id"])
        if isinstance(runs, dict) and "__error__" in runs:
            board.append({"card": key, "error": runs["__error__"]})
            continue
        runs = runs or []
        active = [r for r in runs if (r.get("status") or "").lower() in ACTIVE_RUN_STATUSES]
        newest = runs[0] if runs else None  # newest-first; an old failure behind a live run is stale
        newest_failed = newest if newest and (newest.get("status") or "").lower() == "failed" else None
        fcs, fa, cmins, c_until = (None, None, None, None)
        if newest_failed:
            fcs, fa, cmins, c_until = classify_failure(newest_failed.get("error"))
        last_failed = newest_failed  # entry + cooldown candidates use the newest run only
        fc = fcs
        wakeups = card_wakeups(i["id"])
        idle = idle_minutes(i.get("last_activity_at"))
        live_w, wdetail = wakeup_liveness(wakeups, key, idle, t_start, tcache, chcache)
        wpending = [w for w in wakeups if w.get("enabled") and not w.get("disabled_at")]
        row = agent_row.get(i.get("assignee_id"), {})
        acct_state = row_state(row, t_start) if row else None
        cw = prs_for_card(key, all_prs)
        open_pr = [p for p in cw if (p.get("state") or "").upper() == "OPEN"]

        entry = {
            "card": key, "status": i.get("status"),
            "assignee_id": i.get("assignee_id"), "assignee": i.get("assignee_id"),
            "active_run": bool(active), "active_run_id": (active[0].get("id") if active else None),
            "wakeup_pending": bool(live_w),
            "wakeup_ids": [w.get("id") for w in live_w][:3],
            "wakeup_detail": wdetail,
            "activity_minutes": idle,
            "last_failed_at": (last_failed or {}).get("created_at"),
            "failure_reason": (repr((last_failed or {}).get("error"))[:max_runs_err_len] if last_failed else None),
            "failure_class": fc,
            "runs_seen": len(runs),
            "wip_of_owner": wip.get(i.get("assignee_id"), 0),
            "account": (row or {}).get("account"), "account_state": acct_state,
            "cooldown_until": (row or {}).get("cooldown_until"),
            "prs": [{"repo": p["repo"], "n": p.get("n"), "state": p.get("state"), "base": p.get("base"),
                     "head": p.get("head"), "verdict_on_head": p.get("review_decision"), "checks": p.get("checks"),
                     "updated_at": p.get("updated_at")}
                    for p in cw],
        }
        # action per resume rule (leader scope #3, M-284 reasons):
        # dead-wakeup > partial-stop > wakeup-stale > live-wakeup > fresh >
        # cooldown-routing > idle. Only dead-wakeup redefines wakeup_pending:
        # a card whose only wakeups are dead has no driver. partial-stop
        # yields to a live *strong* driver (fresh at/every/cron or a live
        # condition such as until-pr checks): a scheduled resume or running CI
        # must not be doubled. A stale passive event wait (comment.created)
        # does not block partial-stop. wakeup-stale needs an old unfired wait:
        # a wakeup armed minutes ago has not had its chance yet.
        strong_live = [w for w in live_w
                       if (w.get("condition") or w.get("kind") in ("at", "every", "cron"))]
        stale_wait = [w for w in live_w if (w.get("fire_count") or 0) == 0
                      and (wakeup_age_hours(w, t_start) or 0) > STALE_WAKEUP_HOURS]
        if entry["active_run"]:
            entry["action"], entry["reason"] = "run-live", "run-live"
        elif wpending and not live_w:
            entry["action"], entry["reason"] = "resumable", "dead-wakeup"
        elif open_pr and idle is not None and idle > PARTIAL_STOP_MIN and not strong_live:
            entry["action"], entry["reason"] = "resumable", "partial-stop"
        elif stale_wait and idle is not None and idle > STALE_WAKEUP_HOURS * 60:
            entry["action"], entry["reason"] = "resumable", "wakeup-stale"
        elif live_w:
            entry["action"], entry["reason"] = "wakeup-pending", "live-wakeup"
        elif idle is not None and idle <= IDLE_THRESHOLD_MIN:
            entry["action"], entry["reason"] = "fresh", "fresh"
        elif acct_state == "cooling":
            entry["action"], entry["reason"] = "cooldown-routing", "cooldown-routing"
        else:
            entry["action"], entry["reason"] = "resumable", "idle"
        board.append(entry)
        checked += 1

        # collect confirmed quota signals -> cooldown candidates
        if fc in ("provider_quota_limit", "provider_rate_limit") and fa:
            sig = sig_detections.setdefault(fa, {"signal_runs": [], "cooldown_until": c_until, "minutes": cmins})
            if last_failed and c_until:
                sig["signal_runs"].append({"card": key, "agent": i.get("assignee_id"),
                                           "run_id": last_failed.get("id"), "at": last_failed.get("created_at")})

    cooldown_writes = []
    if apply_cooldown and sig_detections:
        rows = {r["account"]: r for r in ledger.get("rows", [])}
        for acct, sig in sig_detections.items():
            row = rows.get(acct)
            if not row:
                continue
            if row.get("tier") == "unknown":
                continue  # never cooldown unknown tiers
            run_id = (sig["signal_runs"][-1]["run_id"] if sig["signal_runs"] else None)
            if row.get("cooldown_until") and parse_ts(row["cooldown_until"]) and \
               parse_ts(row["cooldown_until"]) > t_start:
                continue  # already cooling; never retry the same account
            row["state"] = "cooling"
            row["cooldown_until"] = sig["cooldown_until"]
            row["last_signal"] = run_id
            cooldown_writes.append({"account": acct, "until": sig["cooldown_until"],
                                    "signal": run_id, "minutes": sig["minutes"]})
        if cooldown_writes:
            payload = json.dumps(ledger, separators=(",", ":"), ensure_ascii=False)
            if len(payload) < 4096:
                rc, _, err = sh(["multica", "issue", "metadata", "set", M86_ID, "--key", LEDGER_KEY,
                                 "--value", payload, "--type", "string"])
                for c in cooldown_writes:
                    c["written"] = rc == 0
                    if rc != 0:
                        c["write_error"] = err.strip()[:150]
            else:
                for c in cooldown_writes:
                    c["written"] = False
                    c["write_error"] = f"ledger exceeds 4KB ({len(payload)}B); not written"

    # todo reroutes: todo cards owned by a cooling account -> next eligible row.
    # Next = first ok row in ENGINEERS_ORDER routing (daily-free, then window burst).
    def first_ok_account(exclude=None):
        seen = set()
        for aid in ENGINEERS_ORDER:
            acct = (agent_row.get(aid) or {}).get("account")
            if not acct or acct in seen or acct == exclude:
                continue
            seen.add(acct)
            if row_state((agent_row.get(aid) or {}), t_start) == "cooling":
                continue
            return acct
        return None
    todo_reroutes = []
    for i in todos:
        row = agent_row.get(i.get("assignee_id"), {})
        if row and row_state(row, t_start) == "cooling":
            todo_reroutes.append({"card": i.get("identifier"), "owner_account": row["account"],
                                  "next_account": first_ok_account(exclude=row["account"])})

    gate_waiting = [{"card": i.get("identifier"), "assignee_id": i.get("assignee_id"),
                     "idle_minutes": idle_minutes(i.get("last_activity_at"))} for i in planing]

    # WIP counts engineer-owned in_progress cards only; the Leader tracks its own
    # cards outside WIP-1 (tick refinement 2026-10-31).
    wip_breaches = [{"agent": aid, "name": (names.get(aid) or {}).get("name"), "in_progress": cnt}
                    for aid, cnt in wip.items() if cnt > 1 and aid in set(ENGINEERS_ORDER)]

    def pool_eligibility(ids, roles):
        out = []
        for aid in ids:
            row = agent_row.get(aid, {})
            out.append({
                "agent": aid, "name": (names.get(aid) or {}).get("name"),
                "account": row.get("account"), "account_state": row_state(row, t_start) if row else "no-row",
                "wip_in_progress": wip.get(aid, 0), "wip_breach": wip.get(aid, 0) > 1,
                "engine_ok": (names.get(aid) or {}).get("status") not in ("archived",),
            })
        return out
    # Committee seats (Lead/Architect amendment 2026-11-07): each seat resolves to the
    # first row whose account is not cooling (ok/expired/unknown/no-row).
    # No WIP filter: seats are not card assignments, and the Leader tracks its own
    # cards outside the engineer WIP-1 rule. One agent never holds both seats.
    # Pools read from M-86 `quota_seats` when present; built-in default otherwise.
    seat_pools = read_seats() or {"lead": LEAD_POOL, "architect": ARCHITECT_POOL}
    seats = {}
    taken = set()
    for seat in ("lead", "architect"):
        ids = seat_pools.get(seat) or []
        elig = pool_eligibility(ids, "reviewer")
        holder = next((e for e in elig if e.get("account_state") in ("ok", "cooldown-expired", "unknown", "no-row")
                       and e.get("agent") not in taken), None)
        if holder:
            taken.add(holder.get("agent"))
        seats[seat] = {"pool": ids, "eligible": elig, "holder": (holder or {}).get("agent"),
                       "holder_name": (holder or {}).get("name")}

    by_action, by_reason = {}, {}
    for b in board:
        a = b.get("action")
        if a:
            by_action[a] = by_action.get(a, 0) + 1
        if a == "resumable":
            r = b.get("reason") or "unknown"
            by_reason[r] = by_reason.get(r, 0) + 1
    counts = {
        "in_progress_total": len(in_prog), "checked": checked, "max_cards_applied": bool(max_cards),
        "by_action": by_action,
        "resumable_by_reason": by_reason,
        "run_live": sum(1 for b in board if b.get("action") == "run-live"),
        "wakeup_pending": sum(1 for b in board if b.get("action") == "wakeup-pending"),
        "resumable": sum(1 for b in board if b.get("action") == "resumable"),
        "cooldown_routing": sum(1 for b in board if b.get("action") == "cooldown-routing"),
        "unknown_failure": sum(1 for b in board if b.get("failure_class") == "unknown"),
        "fresh_<=60m": sum(1 for b in board if b.get("action") == "fresh"),
        "gate_waiting": len(gate_waiting), "todo_reroutes": len(todo_reroutes),
        "loop_seconds": round((now() - t_start).total_seconds(), 1),
    }
    stuck = build_stuck_list(board, issues, t_start, baseline_resume())
    return {"board": board, "gate_waiting": gate_waiting, "todo_reroutes": todo_reroutes,
            "cooldown_writes": cooldown_writes, "counts": counts, "stuck": stuck,
            "queues": fetch_queues(t_start),
            "wip_breaches": wip_breaches, "seats": seats,
            "eligible": {"engineers": pool_eligibility(ENGINEERS_ORDER, "engineer"),
                         "reviewers": pool_eligibility(REVIEWERS_ORDER, "reviewer")}}

# --------------------------------------------------- M-268 stuck-list (committee)
def read_baseline():
    d = sh_json(["multica", "issue", "metadata", "get", M86_ID, "--key", "orch_baseline"])
    if isinstance(d, dict) and "__error__" in d:
        return {}
    val = d.get("value") if isinstance(d, dict) else d
    if val in (None, ""):
        return {}
    try:
        return json.loads(val) if isinstance(val, str) else val
    except json.JSONDecodeError:
        return {}


def baseline_resume():
    b = read_baseline()
    return b.get("resume", {}) if isinstance(b, dict) else {}


def pr_checks_green(pr):
    c = pr.get("checks")
    if c in (None, "none"):
        return False  # no CI signal yet: not provably green, ignore for (a)
    if isinstance(c, dict):
        return not c.get("failing")
    return False


def build_stuck_list(board, issues, t, resume_map):
    """M-268 deterministic stuck-list. No LLM judgment: four threshold rules
    over the sweep board (+ blocked cards + baseline resume counts). Returns
    {hash, triggers, items} where items are {card, trigger, age_min, pr}."""
    by_card = {b.get("card"): b for b in issues and board if b.get("card")}
    items, seen = [], set()

    def add(card, trigger, age_min, pr=None):
        if card in seen:
            return
        seen.add(card)
        items.append({"card": card, "trigger": trigger,
                      "age_min": round(age_min, 1) if age_min is not None else None,
                      "pr": pr})

    # (a) green PR, no verdict on SHA, waiting >30 min, card undriven.
    for b in board:
        if b.get("active_run") or b.get("wakeup_pending"):
            continue
        for p in b.get("prs") or []:
            if (p.get("state") or "").upper() != "OPEN":
                continue
            if p.get("verdict_on_head"):
                continue
            if not pr_checks_green(p):
                continue
            age = idle_minutes(p.get("updated_at"))
            if age is not None and age > VERDICT_WAIT_MIN:
                add(b.get("card"), "no-verdict", age,
                    f"{p.get('repo')}#{p.get('n')}@{p.get('head')}")

    # (b) idle >2 h with a resume already tried.
    for b in board:
        idle = b.get("activity_minutes")
        if idle is None or idle <= STUCK_IDLE_MIN:
            continue
        r = (resume_map or {}).get(b.get("card")) or {}
        if (r.get("count") or 0) >= 1:
            add(b.get("card"), "idle-after-resume", idle)

    # (c) blocked >4 h (blocked cards are in issues but not on the board).
    board_cards = {b.get("card") for b in board}
    for i in issues or []:
        if i.get("status") != "blocked":
            continue
        idle = idle_minutes(i.get("last_activity_at"))
        if idle is not None and idle > BLOCKED_STUCK_MIN:
            if i.get("identifier") not in board_cards:
                add(i.get("identifier"), "blocked", idle)
            else:
                add(i.get("identifier"), "blocked", idle)

    # (d) >=3 cards share one failure_class/reason code.
    codes = {}
    for b in board:
        code = b.get("failure_class") or b.get("reason")
        if code:
            codes.setdefault(code, []).append(b)
    for code, members in codes.items():
        if len(members) >= SHARED_CODE_MIN:
            for b in members:
                add(b.get("card"), f"shared:{code}", b.get("activity_minutes"))

    items.sort(key=lambda x: (x.get("trigger") or "", x.get("card") or ""))
    # Hash over stable identity only (card+trigger+pr): age_min drifts every
    # minute and must not re-arm the committee wake on an unchanged list.
    canon = json.dumps([{"card": x["card"], "trigger": x["trigger"], "pr": x["pr"]}
                        for x in items],
                       sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    digest = hashlib.sha256(canon.encode("utf-8")).hexdigest()[:12]
    triggers = sorted({x["trigger"].split(":")[0] for x in items})
    return {"hash": digest, "triggers": triggers, "items": items}



# --------------------------------------------------------------------- main
def main():
    args = sys.argv[1:]
    apply_cooldown = "--apply-cooldown" in args
    seed = "--seed" in args
    max_cards = 0
    if "--max-cards" in args:
        max_cards = int(args[args.index("--max-cards") + 1])

    names = agent_names()
    prs = fetch_prs()
    ledger, led_err = read_ledger()
    seeded = {}
    if seed or led_err:
        seed_ledger(seeded)
        ledger, led_err = read_ledger()

    result = sweep(ledger, names, all_prs=prs, apply_cooldown=apply_cooldown, max_cards=max_cards)
    if "--stuck-list" in args:
        print(json.dumps({"at": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
                          "tool": "orch-sweep", "mode": "stuck-list",
                          **result["stuck"]}, indent=1, ensure_ascii=False))
        return 0
    out = {
        "at": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
        "tool": "orch-sweep", "leader_scope": LEADER_SCOPE,
        "ledger_error": led_err, "ledger_seed": seeded or None,
        **result,
    }
    return 0


if __name__ == "__main__":
    sys.exit(main())
