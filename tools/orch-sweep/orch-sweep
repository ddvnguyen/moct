def wakeup_age_hours(w, t):
    c = parse_ts(w.get("created_at"))
    return (t - c).total_seconds() / 3600.0 if c else None


def target_status(identifier):
    """Status of another issue by M-key, or None when it cannot be read."""
    d = sh_json(["multica", "issue", "get", identifier, "--output", "json"])
    if isinstance(d, dict) and d.get("status") and "__error__" not in d:
        return d.get("status")
    return None


def children_statuses(card_key):
    """Statuses of a card's sub-issues, or None when unreadable."""
    d = sh_json(["multica", "issue", "children", card_key, "--output", "json"])
    if not isinstance(d, dict) or "__error__" in d:
        return None
    out = []
    for s in d.get("stages", []) or []:
        out += [(c.get("status") or "?") for c in s.get("issues", []) or []]
    out += [(c.get("status") or "?") for c in d.get("unstaged", []) or []]
    return out


def classify_wakeup(w, card_key, idle_min, t, tcache, chcache):
    """M-284 r1: live or dead + dead reason. Dead wakeups never fire, so a
    card whose only wakeups are dead has no driver (reason dead-wakeup)."""
    cond = w.get("condition") or {}
    ctype = cond.get("type")
    if w.get("last_error"):
        return False, "last-error"
    if ctype == "children_done":
        if card_key not in chcache:
            chcache[card_key] = children_statuses(card_key)
        sts = chcache[card_key]
        if sts is not None:
            open_sts = [s for s in sts if s not in ("done", "cancelled")]
            if open_sts and not any(s in PROGRESSIBLE for s in open_sts):
                # every open child sits in an Owner-held state (in_review) or
                # blocked/waiting: nothing here auto-closes, can never fire
                return False, "children-stuck"
    elif ctype == "other_issue":
        ident, wait = cond.get("identifier"), (cond.get("state") or "done")
        if ident:
            if ident not in tcache:
                tcache[ident] = target_status(ident)
            ts = tcache[ident]
            if ts is None:
                return False, "target-missing"
            if wait == "in_review" and ts in ("blocked", "done", "cancelled"):
                return False, "target-irrelevant"
            if wait == "done" and ts == "cancelled":
                return False, "target-irrelevant"
    if ctype is not None:
        age_h = wakeup_age_hours(w, t)
        if age_h is not None and age_h > STALE_WAKEUP_HOURS and \
                idle_min is not None and idle_min > STALE_WAKEUP_HOURS * 60:
            return False, "condition-stale"
    return True, None


def wakeup_liveness(wakeups, card_key, idle_min, t, tcache, chcache):
    """-> (live_list, [(id6, kind, live, dead_reason)]) for enabled wakeups."""
    live, detail = [], []
    for w in wakeups:
        if not (w.get("enabled") and not w.get("disabled_at")):
            continue
        is_live, why = classify_wakeup(w, card_key, idle_min, t, tcache, chcache)
        if is_live:
            live.append(w)
        kind = ((w.get("condition") or {}).get("type") or "+".join(w.get("event_types") or [])
                or w.get("kind") or "?")
        detail.append({"id": (w.get("id") or "")[:8], "kind": kind,
                       "live": is_live, "dead_reason": why})
    return live, detail


def fetch_prs():
    """One gh call per repo -> open PRs with head sha + review decision."""
    prs = []
    for repo in GITHUB_REPOS:
        d = sh_json(["gh", "pr", "list", "--repo", repo, "--state", "open", "--limit", "50", "--json",
                     "number,title,state,headRefOid,reviewDecision,statusCheckRollup,baseRefName,updatedAt"], timeout=60)
        rows = d if isinstance(d, list) else []
        if not rows and isinstance(d, dict) and "__error__" in d:
            prs.append({"repo": repo, "error": d["__error__"][:120]})
            continue
        for r in rows:
            roll = r.get("statusCheckRollup") or []
            fails = [c.get("name") or c.get("conclusion") or "?" for c in roll
                     if isinstance(c, dict) and str(c.get("conclusion", "")).upper() in
                     ("FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE")]
            checks = {"total": len(roll), "failing": fails[:3]} if roll else None
            prs.append({"repo": repo, "n": r.get("number"), "title": r.get("title"),
                        "state": r.get("state"), "base": r.get("baseRefName"),
                        "head": (r.get("headRefOid") or "")[:8],
                        "review_decision": r.get("reviewDecision") or None,
                        "checks": checks or "none", "updated_at": r.get("updatedAt")})
    return prs


