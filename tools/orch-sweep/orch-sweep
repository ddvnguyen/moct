    return rows, bool(isinstance(d, dict) and d.get("has_more"))


def fetch_queues(t):
    """M-284 r4: stuck-queue gates the sweep lists for the Leader every tick.
    in_review is count-only (dozens of cards); the three actionable queues list
    every card over 24 h idle so the committee wake (M-268) can slice them."""
    queues = {}
    for st in ("agent_review_deploy", "wait_for_decision", "todo"):
        rows, offset = [], 0
        while True:
            page, more = fetch_status_page(st, offset=offset)
            rows += page
            if not more or not page:
                break
            offset += len(page)
        old = []
        for r in rows:
            idle = idle_minutes(r.get("last_activity_at"))
            if idle is not None and idle > STALE_WAKEUP_HOURS * 60:
                old.append({"card": r.get("identifier"), "assignee_id": r.get("assignee_id"),
                            "idle_hours": round(idle / 60.0, 1)})
        old.sort(key=lambda x: x["idle_hours"], reverse=True)
        q = {"total": len(rows), "older_24h": len(old), "cards": old}
        if st == "agent_review_deploy" and old:
            mid = sorted(c["idle_hours"] for c in old)[len(old) // 2]
            q["median_idle_days"] = round(mid / 24.0, 1)
        queues[st] = q
    rows, offset = [], 0
    while True:
        page, more = fetch_status_page("in_review", offset=offset)
        rows += page
        if not more or not page:
            break
        offset += len(page)
    old_n = sum(1 for r in rows
                if (idle_minutes(r.get("last_activity_at")) or 0) > STALE_WAKEUP_HOURS * 60)
    queues["in_review"] = {"total": len(rows), "older_24h": old_n}
    return queues


