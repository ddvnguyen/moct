def read_baseline():
    d = sh_json(["multica", "issue", "metadata", "get", M86_ID, "--key", "orch_baseline"])
    if isinstance(d, dict) and "__error__" in d:
        return {}
    val = d.get("value") if isinstance(d, dict) else d
    if val in (None, ""):
        return {}
    try:
        return json.loads(val) if isinstance(val, str) else val
    except json.JSONDecodeError:
        return {}


# ---------------------------------------------- M-393 incomplete-turn detector
INCOMPLETE_REMINDER = (
    "Your previous run ended without an issue-state result. Continue the task, "
    "then finish by handing off, advancing the issue with evidence, sending a "
    "native ask/plan, or arming an expiring wakeup. Do not end with a progress "
    "note or ‘standing by’."
)


def incomplete_turns_default_state():
    return {"last_sweep_at": None, "processed_run_ids": [], "counts": {}}


def load_incomplete_turns_state():
    d = sh_json(["multica", "issue", "metadata", "get", M86_ID,
                 "--key", INCOMPLETE_TURNS_KEY])
    if not isinstance(d, dict) or "__error__" in d:
        error = d.get("__error__", "unreadable metadata") if isinstance(d, dict) else "bad metadata response"
        if "not found on issue" in error.lower():
            return incomplete_turns_default_state(), None
        return None, error
    value = d.get("value")
    if value in (None, ""):
        return incomplete_turns_default_state(), None
    try:
        state = json.loads(value) if isinstance(value, str) else value
    except (TypeError, json.JSONDecodeError):
        return None, "invalid metadata JSON"
    if not isinstance(state, dict) or not isinstance(state.get("counts", {}), dict):
        return None, "invalid metadata shape"
    try:
        if any(int(value) < 0 or int(value) > 2 for value in state.get("counts", {}).values()):
            return None, "invalid occurrence count"
    except (TypeError, ValueError):
        return None, "invalid occurrence count"
    if (not isinstance(state.get("processed_run_ids", []), list) or
            any(not isinstance(rid, str) for rid in state.get("processed_run_ids", []))):
        return None, "invalid processed run IDs"
    state.setdefault("last_sweep_at", None)
    state.setdefault("processed_run_ids", [])
    state.setdefault("counts", {})
    return state, None


def save_incomplete_turns_state(state):
    payload = json.dumps(state, separators=(",", ":"), ensure_ascii=False)
    if len(payload.encode("utf-8")) >= 4000:
        return False, "incomplete-turn ledger exceeds 4KB"
    rc, _, err = sh(["multica", "issue", "metadata", "set", M86_ID,
                     "--key", INCOMPLETE_TURNS_KEY, "--value", payload,
                     "--type", "string"])
    return rc == 0, err.strip()[:200] if rc != 0 else None


def timestamp_in_run(value, run):
    event_at = parse_ts(value)
    started = parse_ts(run.get("started_at"))
    completed = parse_ts(run.get("completed_at"))
    return bool(event_at and started and completed and event_at.tzinfo and
                started.tzinfo and completed.tzinfo and
                started <= event_at <= completed)


def history_has_ambiguous_timestamps(activities, comments, wakeups):
    """History reads are complete records; an unknown event time cannot prove no delta."""
    for rows in (activities, comments, wakeups):
        for row in rows:
            event_at = parse_ts(row.get("created_at"))
            if event_at is None or event_at.tzinfo is None:
                return True
    return False


def run_has_incomplete_turn_delta(run, activities, comments, wakeups):
    """Whether this completed run made one of the D6 state changes."""
    for event in activities:
        if event.get("action") in ("status_changed", "assignee_changed") and \
           timestamp_in_run(event.get("created_at"), run):
            return True
    for comment in comments:
        if comment.get("author_id") == run.get("agent_id") and \
           timestamp_in_run(comment.get("created_at"), run):
            return True
    for wakeup in wakeups:
        if timestamp_in_run(wakeup.get("created_at"), run):
            return True
    return False


def classify_incomplete_turns(issues, histories, activities, comments, wakeups,
                              state, t=None, max_issues=INCOMPLETE_TURNS_MAX_ISSUES):
    """Pure D6 classifier. Inputs are snapshots keyed by issue id; unreadable
    snapshots are represented by an error string and fail closed. The returned
    state is safe to persist only after the caller has handled every action."""
    t = t or now()
    state = json.loads(json.dumps(state or incomplete_turns_default_state()))
    previous_sweep = parse_ts(state.get("last_sweep_at"))
    processed = set(state.get("processed_run_ids") or [])
    counts = state.setdefault("counts", {})
    actions, skipped, processed_now = [], [], []
    working = [i for i in (issues or [])
               if i.get("status") in INCOMPLETE_WORKING_STATUSES and i.get("assignee_id")]
    working.sort(key=lambda i: i.get("identifier") or i.get("id") or "")
    cursor = state.get("cursor")
    if cursor and working:
        split = next((n + 1 for n, item in enumerate(working)
                      if (item.get("identifier") or item.get("id") or "") > cursor), len(working))
        working = working[split:] + working[:split]
    selected = working[:max(0, max_issues)]
    truncated = len(working) > len(selected)
    failures = False

    for issue in selected:
        iid = issue.get("id")
        if iid not in histories or isinstance(histories.get(iid), dict):
            failures = True
            skipped.append({"issue": issue.get("identifier"), "reason": "runs_unreadable"})
            continue
        runs = histories.get(iid) or []
        candidates = []
        for run in runs:
            completed = parse_ts(run.get("completed_at"))
            started = parse_ts(run.get("started_at"))
            rid = run.get("id")
            if (run.get("status") != "completed" or not completed or not started or
                    not rid or rid in processed or
                    (previous_sweep and completed <= previous_sweep)):
                continue
            candidates.append(run)
        if not candidates:
            continue
        if (iid not in activities or iid not in comments or iid not in wakeups or
                any(isinstance(rows, dict) for rows in
                    (activities.get(iid), comments.get(iid), wakeups.get(iid)))):
            failures = True
            skipped.append({"issue": issue.get("identifier"), "reason": "history_unreadable"})
            continue
        candidates.sort(key=lambda r: (r.get("completed_at") or "", r.get("id") or ""))
        issue_events = activities[iid]
        issue_comments = comments[iid]
        issue_wakeups = wakeups[iid]
        if history_has_ambiguous_timestamps(issue_events, issue_comments, issue_wakeups):
            failures = True
            skipped.append({"issue": issue.get("identifier"), "reason": "ambiguous_history_timestamp"})
            continue
        for run in candidates:
            rid, aid = run["id"], run.get("agent_id")
            if not aid:
                failures = True
                skipped.append({"issue": issue.get("identifier"), "reason": "run_agent_missing"})
                continue
            key = f"{issue.get('identifier') or iid}:{aid}"
            if run_has_incomplete_turn_delta(run, issue_events, issue_comments, issue_wakeups):
                counts.pop(key, None)
                processed_now.append(rid)
                continue
            if (issue.get("status") not in INCOMPLETE_WORKING_STATUSES or
                    issue.get("assignee_id") != aid):
                counts.pop(key, None)
                processed_now.append(rid)
                continue
            count = int(counts.get(key) or 0)
            if count >= 2:
                processed_now.append(rid)
                continue
            if count < 2:
                count += 1
            counts[key] = count
            processed_now.append(rid)
            if aid == INCOMPLETE_LEADER_ID:
                action = "leader_noop"
                target = aid
            elif count == 1:
                action = "requeue_same_agent"
                target = aid
            elif count == 2:
                action = "assign_leader"
                target = INCOMPLETE_LEADER_ID
            else:
                continue
            actions.append({"issue": issue.get("identifier"), "issue_id": iid,
                            "run_id": rid, "agent_id": aid, "occurrence": count,
                            "action": action, "target_agent_id": target,
                            "reminder": INCOMPLETE_REMINDER})

    processed_ids = list(dict.fromkeys((state.get("processed_run_ids") or []) + processed_now))
    state["processed_run_ids"] = processed_ids[-40:]
    state["counts"] = dict(list(counts.items())[-40:])
    # An unreadable issue keeps the old boundary so its candidate runs are retried.
    if truncated:
        skipped.append({"reason": "issue_cap", "uninspected": len(working) - len(selected)})
        if selected:
            state["cursor"] = selected[-1].get("identifier") or selected[-1].get("id")
    elif not failures:
        state["last_sweep_at"] = t.isoformat().replace("+00:00", "Z")
        state.pop("cursor", None)
    return {"checked_issues": len(selected), "eligible_issues": len(working),
            "actions": actions, "skipped": skipped, "state": state}


def collect_incomplete_turns(issues, max_issues=INCOMPLETE_TURNS_MAX_ISSUES, issue_errors=None):
    if issue_errors:
        return {"checked_issues": 0, "eligible_issues": 0, "actions": [],
                "skipped": [{"reason": "issue_list_unreadable", "errors": issue_errors}],
                "state": None}
    state, state_error = load_incomplete_turns_state()
    if state_error:
        return {"checked_issues": 0, "eligible_issues": 0, "actions": [],
                "skipped": [{"reason": "ledger_unreadable", "detail": state_error}],
                "state": None}
    t = now()
    last_sweep = parse_ts(state.get("last_sweep_at"))
    if state.get("last_sweep_at") and (last_sweep is None or last_sweep.tzinfo is None):
        return {"checked_issues": 0, "eligible_issues": 0, "actions": [],
                "skipped": [{"reason": "ledger_unreadable", "detail": "ambiguous last_sweep_at"}],
                "state": None}
    if last_sweep is None:
        # Establish a baseline rather than reprocessing the issue's full history.
        state["last_sweep_at"] = t.isoformat().replace("+00:00", "Z")
        last_sweep = t
    working = [i for i in (issues or [])
               if i.get("status") in INCOMPLETE_WORKING_STATUSES and i.get("assignee_id")]
    working.sort(key=lambda i: i.get("identifier") or i.get("id") or "")
    cursor = state.get("cursor")
    if cursor and working:
        split = next((n + 1 for n, item in enumerate(working)
                      if (item.get("identifier") or item.get("id") or "") > cursor), len(working))
        working = working[split:] + working[:split]
    selected = working[:max(0, max_issues)]
    histories, activities, comments, wakeups = {}, {}, {}, {}
    for issue in selected:
        iid = issue.get("id")
        runs = sh_json(["multica", "issue", "runs", iid, "--output", "json"])
        if isinstance(runs, dict) and "__error__" in runs:
            histories[iid] = runs
            continue
        if isinstance(runs, dict):
            runs = runs.get("runs", [])
        histories[iid] = runs if isinstance(runs, list) and all(isinstance(r, dict) for r in runs) else {"__error__": "bad run response"}
        if isinstance(histories[iid], dict):
            continue
        new_runs = []
        bad_run_timestamp = False
        for run in histories[iid]:
            if run.get("status") != "completed" or run.get("id") in (state.get("processed_run_ids") or []):
                continue
            if not run.get("id") or not run.get("agent_id"):
                bad_run_timestamp = True
                break
            completed = parse_ts(run.get("completed_at"))
            started = parse_ts(run.get("started_at"))
            if completed is None or started is None or completed.tzinfo is None or started.tzinfo is None:
                bad_run_timestamp = True
                break
            if not last_sweep or completed > last_sweep:
                new_runs.append(run)
        if bad_run_timestamp:
            histories[iid] = {"__error__": "ambiguous run timestamp"}
            continue
        if not new_runs:
            continue
        starts = [parse_ts(r.get("started_at")) for r in new_runs]
        if not all(starts):
            activities[iid] = {"__error__": "ambiguous run timestamp"}
            continue
        since = min(starts).isoformat().replace("+00:00", "Z")
        acts = sh_json(["multica", "issue", "timeline", iid, "--action",
                        "status_changed,assignee_changed", "--activity-only",
                        "--since", since, "--output", "json"])
        comms = sh_json(["multica", "issue", "comment", "list", iid,
                         "--since", since, "--output", "json"])
        wakes = sh_json(["multica", "issue", "wakeup", "list", iid, "--output", "json"])
        activities[iid] = acts if isinstance(acts, list) else acts.get("activities", acts.get("events", [])) if isinstance(acts, dict) and "__error__" not in acts else {"__error__": "unreadable timeline"}
        comments[iid] = comms if isinstance(comms, list) else comms.get("comments", []) if isinstance(comms, dict) and "__error__" not in comms else {"__error__": "unreadable comments"}
        wakeups[iid] = wakes if isinstance(wakes, list) else wakes.get("wakeups", []) if isinstance(wakes, dict) and "__error__" not in wakes else {"__error__": "unreadable wakeups"}
        if any(not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows)
               for rows in (activities[iid], comments[iid], wakeups[iid])):
            activities[iid] = {"__error__": "malformed history"}
    return classify_incomplete_turns(issues, histories, activities, comments,
                                     wakeups, state, t=t, max_issues=max_issues)


def baseline_resume():
    b = read_baseline()
    return b.get("resume", {}) if isinstance(b, dict) else {}


def pr_checks_green(pr):
    c = pr.get("checks")
    if c in (None, "none"):
        return False  # no CI signal yet: not provably green, ignore for (a)
    if isinstance(c, dict):
        return not c.get("failing")
    return False


def build_stuck_list(board, issues, t, resume_map):
    """M-268 deterministic stuck-list. No LLM judgment: four threshold rules
    over the sweep board (+ blocked cards + baseline resume counts). Returns
    {hash, triggers, items} where items are {card, trigger, age_min, pr}."""
    items, seen = [], set()

    def add(card, trigger, age_min, pr=None):
        if card in seen:
            return
        seen.add(card)
        items.append({"card": card, "trigger": trigger,
                      "age_min": round(age_min, 1) if age_min is not None else None,
                      "pr": pr})

    # (a) green PR, no verdict on SHA, waiting >30 min, card undriven.
    for b in board:
        if b.get("active_run") or b.get("wakeup_pending"):
            continue
        for p in b.get("prs") or []:
            if (p.get("state") or "").upper() != "OPEN":
                continue
            if p.get("verdict_on_head"):
                continue
            if not pr_checks_green(p):
                continue
            age = idle_minutes(p.get("updated_at"))
            if age is not None and age > VERDICT_WAIT_MIN:
                add(b.get("card"), "no-verdict", age,
                    f"{p.get('repo')}#{p.get('n')}@{p.get('head')}")

    # (b) idle >2 h with a resume already tried.
    for b in board:
        idle = b.get("activity_minutes")
        if idle is None or idle <= STUCK_IDLE_MIN:
            continue
        r = (resume_map or {}).get(b.get("card")) or {}
        if (r.get("count") or 0) >= 1:
            add(b.get("card"), "idle-after-resume", idle)

    # (c) blocked >4 h (blocked cards are in issues but not on the board).
    for i in issues or []:
        if i.get("status") != "blocked":
            continue
        idle = idle_minutes(i.get("last_activity_at"))
        if idle is not None and idle > BLOCKED_STUCK_MIN:
            add(i.get("identifier"), "blocked", idle)

    # (d) >=3 cards share one failure_class/reason code.
    codes = {}
    for b in board:
        code = b.get("failure_class") or b.get("reason")
        if code:
            codes.setdefault(code, []).append(b)
    for code, members in codes.items():
        if len(members) >= SHARED_CODE_MIN:
            for b in members:
                add(b.get("card"), f"shared:{code}", b.get("activity_minutes"))

    items.sort(key=lambda x: (x.get("trigger") or "", x.get("card") or ""))
    # Hash over stable identity only (card+trigger+pr): age_min drifts every
    # minute and must not re-arm the committee wake on an unchanged list.
    canon = json.dumps([{"card": x["card"], "trigger": x["trigger"], "pr": x["pr"]}
                        for x in items],
                       sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    digest = hashlib.sha256(canon.encode("utf-8")).hexdigest()[:12]
    triggers = sorted({x["trigger"].split(":")[0] for x in items})
    return {"hash": digest, "triggers": triggers, "items": items}

# --------------------------------------------- M-328 free-questions (Owner)
# Flags agent comments that read as free-text questions to the Owner with no
# ask card from the same run. Heuristic only, no LLM call:
#   * agent-authored, type "comment" (system / progress_update never count);
#   * created within the window (--hours N, default 24);
#   * body has no [WAKEUP] marker and is not an evidence block;
#   * last non-empty line ends in "?" or names an Owner decision
#     ("owner, please decide", "which option", "approve plan v<N>");
#   * no ask card live on the issue from the same run: no run whose
#     trigger_comment_id is this comment, or whose attribution evidence is a
#     question_answer/question_card ref created after this comment.
# Chat-mode tasks (runs without an issue / trigger_comment) are exempt: there
# is no thread to park a card in (M-325 decision), the human is live.
FREEQ_DEFAULT_HOURS = 24
FREEQ_DECISION_RES = [
    re.compile(r"owner[,\s]+please decide", re.I),
    re.compile(r"which option", re.I),
    re.compile(r"approve plan v\d+", re.I),
    re.compile(r"one decision for the owner", re.I),
]


def freeq_last_line(content):
    """Last non-empty line with fenced code stripped; "" when none."""
    body = re.sub(r"```.*?```", "", content or "", flags=re.S)
    lines = [ln.strip() for ln in body.splitlines() if ln.strip()]
    if not lines:
        return ""
    last = re.sub(r"^#+\s*", "", lines[-1])  # tolerate a heading tail
    return last


def freeq_matches(content):
    """(flagged, signal): signal is the matched tail or decision phrase."""
    if not content or "[WAKEUP]" in content:
        return False, ""
    tail = freeq_last_line(content)
    if not tail or len(tail) < 3:
        return False, ""
    low = tail.lower()
    if "evidence block" in low or "merged, not deployed" in low:
        return False, ""
    if tail.rstrip().endswith("?"):
        return True, tail[:160]
    for rx in FREEQ_DECISION_RES:
        m = rx.search(content)
        if m:
            return True, m.group(0)[:160]
    return False, ""


def freeq_has_ask_card(runs, comment, names=None):
    """True when a run on this issue already carries an ask from the comment's
    run: the comment is (or answers) a parked ask. Runs arrive newest-first."""
    cid = (comment.get("id") or "")
    cts = parse_ts(comment.get("created_at"))
    sid = comment.get("source_task_id") or ""
    for r in runs or []:
        if (r.get("trigger_comment_id") or "") == cid and cid:
            return True
        ev = ((r.get("attribution") or {}).get("evidence") or {})
        if ev.get("kind") in ("question_answer", "question_card") and ev.get("ref_id"):
            rts = parse_ts(r.get("created_at"))
            if sid and (r.get("id") or "") == sid:
                return True
            if cts and rts and abs((rts - cts).total_seconds()) <= 15 * 60:
                return True
    return False


def scan_free_questions(issues, hours, names=None):
    """One --since pass per board issue; returns {checked, offenders[]}.
    offenders carry {card, comment, agent, created_at, signal}: the daily
    ticket paste (issue, comment id, agent), once per comment."""
    cutoff = now() - timedelta(hours=hours)
    since = cutoff.strftime("%Y-%m-%dT%H:%M:%SZ")
    offenders, checked, seen = [], 0, set()
    for i in issues or []:
        key = i.get("identifier") or i.get("id")
        d = sh_json(["multica", "issue", "comment", "list", i.get("id"),
                     "--since", since, "--compact", "--output", "json"], timeout=120)
        rows = d if isinstance(d, list) else d.get("comments", []) if isinstance(d, dict) else []
        if isinstance(d, dict) and "__error__" in d:
            continue
        runs = card_runs(i.get("id"))
        if isinstance(runs, dict) and "__error__" in runs:
            runs = []
        for c in rows or []:
            if c.get("author_type") != "agent" or (c.get("type") or "") != "comment":
                continue
            cts = parse_ts(c.get("created_at"))
            if not cts or cts < cutoff:
                continue
            ok, signal = freeq_matches(c.get("content") or "")
            if not ok or freeq_has_ask_card(runs, c, names):
                continue
            if c.get("id") in seen:
                continue
            seen.add(c.get("id"))
            checked += 1
            aid = c.get("author_id")
            offenders.append({"card": key, "comment": (c.get("id") or "")[:8],
                              "comment_id": c.get("id"), "agent": (names or {}).get(aid, {}).get("name") if isinstance(names, dict) else aid,
                              "agent_id": aid, "created_at": c.get("created_at"), "signal": signal})
    offenders.sort(key=lambda o: (o.get("card") or "", o.get("created_at") or ""))
    return {"hours": hours, "issues_scanned": len(issues or []),
            "comments_flagged": checked, "offenders": offenders}


# -------------------------------------- M-391 illegal-endings (turn-end text)
# Flags agent comments that end a turn with language the turn-end contract
# forbids: the run stops without handing off, advancing, asking, or arming a
# wakeup. Text-pattern complement to the M-393 state-delta detector (which
# looks at run/status/wakeup deltas, never at comment wording): this check
# looks only at wording, never at deltas. Heuristic only, no LLM call:
#   * agent-authored, type "comment" (system / progress_update never count);
#   * created within the window (--hours N, default 24);
#   * body has no [WAKEUP] marker and is not an evidence block (same
#     exclusions as M-328: fenced code is stripped before matching);
#   * body matches an illegal turn-ending signal (case-insensitive):
#     "standing by" / "stand by", "waiting for review", "<role> needed"
#     with no trigger (lane operator, claude/architect, leader, owner,
#     operator, reviewer), "next:" / "next step" assigning work to an
#     unnamed person, "someone should", "to-do for" an unnamed owner.
# The "unnamed" signals (role-needed, next-unnamed, someone-should,
# todo-for) are skipped when the comment names an owner (@mention or
# mention:// link): naming someone IS a trigger. "standing by" and
# "waiting for review" flag regardless.
# Exempt when the comment's run already drove the turn: an open ask card
# from the same run (M-328 freeq_has_ask_card) or an enabled wakeup armed
# by the same run (same source_task_id / trigger_comment_id, or created
# within 15 min after the comment). Read-only: never writes to cards.
ILLEGAL_ENDINGS_DEFAULT_HOURS = 24
ILLEGAL_WAKEUP_WINDOW_MIN = 15
ILLEGAL_ENDINGS_RES = [
    (re.compile(r"\bstand(?:ing)?\s+by\b", re.I), "standing-by"),
    (re.compile(r"\bwaiting for review\b", re.I), "waiting-for-review"),
    (re.compile(r"\b(?:lane operator|claude architect|opus architect|architect|leader|owner|operator|reviewer)\s+needed\b", re.I), "role-needed"),
    (re.compile(r"\bnext(?:\s+step)?\s*:|\bnext\s+step\b", re.I), "next-unnamed"),
    (re.compile(r"\bsomeone should\b", re.I), "someone-should"),
    (re.compile(r"\bto-?do for\b", re.I), "todo-for-unnamed"),
]
# Signals that require an unnamed owner: skipped when the comment names one.
ILLEGAL_NAMED_OWNER_RE = re.compile(r"@\S|mention://")
ILLEGAL_UNNAMED_SIGNALS = {"role-needed", "next-unnamed", "someone-should",
                           "todo-for-unnamed"}


def illegal_endings_matches(content):
    """(flagged, signal): first illegal turn-ending signal, or (False, "")
    when clean or excluded (WAKEUP marker, evidence block, fenced-only)."""
    if not content or "[WAKEUP]" in content:
        return False, ""
    low = content.lower()
    if "evidence block" in low or "merged, not deployed" in low:
        return False, ""
    body = re.sub(r"```.*?```", "", content, flags=re.S)
    if not body.strip():
        return False, ""
    named = bool(ILLEGAL_NAMED_OWNER_RE.search(body))
    for rx, name in ILLEGAL_ENDINGS_RES:
        m = rx.search(body)
        if not m:
            continue
        if name in ILLEGAL_UNNAMED_SIGNALS and named:
            continue  # names an owner: that IS the trigger
        return True, "%s: %s" % (name, m.group(0).strip()[:120])
    return False, ""


def illegal_has_same_run_driver(runs, wakeups, comment):
    """True when the comment's run already drove the turn: a parked ask card
    (same-run M-328 exemption) or an enabled wakeup armed by the same run."""
    if freeq_has_ask_card(runs, comment):
        return True
    cid = comment.get("id") or ""
    cts = parse_ts(comment.get("created_at"))
    sid = comment.get("source_task_id") or ""
    for w in wakeups or []:
        if not isinstance(w, dict) or "__error__" in w:
            continue
        if not (w.get("enabled") and not w.get("disabled_at")):
            continue
        if sid and w.get("source_task_id") == sid:
            return True
        if cid and w.get("trigger_comment_id") == cid:
            return True
        wts = parse_ts(w.get("created_at"))
        if cts and wts:
            delta = (wts - cts).total_seconds()
            if 0 <= delta <= ILLEGAL_WAKEUP_WINDOW_MIN * 60:
                return True
    return False


def scan_illegal_endings(issues, hours, names=None):
    """One --since pass per board issue; returns {checked, offenders[]}.
    offenders carry {card, comment, agent, created_at, signal}: the daily
    ticket paste (issue, comment id, agent), once per comment."""
    cutoff = now() - timedelta(hours=hours)
    since = cutoff.strftime("%Y-%m-%dT%H:%M:%SZ")
    offenders, checked, scanned, seen = [], 0, 0, set()
    for i in issues or []:
        key = i.get("identifier") or i.get("id")
        d = sh_json(["multica", "issue", "comment", "list", i.get("id"),
                     "--since", since, "--compact", "--output", "json"], timeout=120)
        rows = d if isinstance(d, list) else d.get("comments", []) if isinstance(d, dict) else []
        if isinstance(d, dict) and "__error__" in d:
            continue
        runs = card_runs(i.get("id"))
        if isinstance(runs, dict) and "__error__" in runs:
            runs = []
        wakes = card_wakeups(i.get("id"))
        if isinstance(wakes, dict) and "__error__" in wakes:
            wakes = []
        for c in rows or []:
            if c.get("author_type") != "agent" or (c.get("type") or "") != "comment":
                continue
            cts = parse_ts(c.get("created_at"))
            if not cts or cts < cutoff:
                continue
            scanned += 1
            ok, signal = illegal_endings_matches(c.get("content") or "")
            if not ok or illegal_has_same_run_driver(runs, wakes, c):
                continue
            if c.get("id") in seen:
                continue
            seen.add(c.get("id"))
            checked += 1
            aid = c.get("author_id")
            offenders.append({"card": key, "comment": (c.get("id") or "")[:8],
                              "comment_id": c.get("id"), "agent": (names or {}).get(aid, {}).get("name") if isinstance(names, dict) else aid,
                              "agent_id": aid, "created_at": c.get("created_at"), "signal": signal})
    offenders.sort(key=lambda o: (o.get("card") or "", o.get("created_at") or ""))
    return {"hours": hours, "issues_scanned": len(issues or []),
            "checked": scanned, "comments_flagged": checked,
            "offenders": offenders}



# --------------------------------------------------------------------- main
def main():
    args = sys.argv[1:]
    apply_cooldown = "--apply-cooldown" in args
    apply_incomplete_turns = "--apply-incomplete-turns" in args and "--stuck-list" not in args
    seed = "--seed" in args
    max_cards = 0
    if "--max-cards" in args:
        max_cards = int(args[args.index("--max-cards") + 1])
    hours = FREEQ_DEFAULT_HOURS
    if "--hours" in args:
        hours = int(args[args.index("--hours") + 1])

    if "--free-questions" in args:
        fq_names = agent_names()
        fq_d = fetch_issues()
        fq_issues = fq_d if isinstance(fq_d, list) else fq_d.get("issues", [])
        fq = scan_free_questions(fq_issues, hours, fq_names)
        print(json.dumps({"at": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
                          "tool": "orch-sweep", "mode": "free-questions",
                          **fq}, indent=1, ensure_ascii=False))
        return 0

    if "--illegal-endings" in args:
        ie_names = agent_names()
        ie_d = fetch_issues()
        ie_issues = ie_d if isinstance(ie_d, list) else ie_d.get("issues", [])
        ie = scan_illegal_endings(ie_issues, hours, ie_names)
        print(json.dumps({"at": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
                          "tool": "orch-sweep", "mode": "illegal-endings",
                          **ie}, indent=1, ensure_ascii=False))
        return 0

    names = agent_names()
    prs = fetch_prs()
    ledger, led_err = read_ledger()
    seeded = {}
    if seed or led_err:
        seed_ledger(seeded)
        ledger, led_err = read_ledger()
    result = sweep(ledger, names, all_prs=prs, apply_cooldown=apply_cooldown,
                   max_cards=max_cards, apply_incomplete_turns=apply_incomplete_turns)
    if "--stuck-list" in args:
        print(json.dumps({"at": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
                          "tool": "orch-sweep", "mode": "stuck-list",
                          **result["stuck"]}, indent=1, ensure_ascii=False))
        return 0
    out = {
        "at": now().strftime("%Y-%m-%dT%H:%M:%SZ"),
        "tool": "orch-sweep", "leader_scope": LEADER_SCOPE,
        "ledger_error": led_err, "ledger_seed": seeded or None,
        **result,
    }
    print(json.dumps(out, indent=1, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
