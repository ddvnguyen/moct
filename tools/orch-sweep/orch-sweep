# ---------------------------------------------------------------- utilities
def sh(args, timeout=90):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s: {' '.join(args[:3])}"


def sh_json(args, timeout=90):
    rc, out, err = sh(args, timeout)
    if rc != 0:
        return {"__error__": f"rc={rc} {err.strip()[:200]}"}
    try:
        return json.loads(out)
    except json.JSONDecodeError as e:
        return {"__error__": f"bad json ({e}) from {' '.join(args[:3])}"}


def now():
    return datetime.now(timezone.utc)


def parse_ts(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def idle_minutes(ts):
    t = parse_ts(ts)
    if not t:
        return None
    return round((now() - t).total_seconds() / 60.0, 1)


def until_iso(minutes=None, until=None):
    t = until or (now() + timedelta(minutes=minutes))
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


# ------------------------------------------------------- failure classifier
RESET_RE = re.compile(r"weekly limit|session limit", re.I)
RESET_TIME_RE = re.compile(r"resets?\s+(\d{1,2}(?::\d{2})?)\s*(am|pm)", re.I)


def classify_failure(err):
    """-> (class, account_hint, cooldown_minutes or None, cooldown_until_iso or None)
    Only classes in CONFIRMED signals produce cooldowns. Return (None,..) for no error."""
    if not err:
        return None, None, None, None
    e = err.strip()

    # OMP Go quota (confirmed) — carry the provider's own retry-after
    m = re.search(r"retry-after-ms=(\d+)", e)
    if m or "GoUsageLimitError" in e or "Go usage limit" in e:
        ms = int(m.group(1)) if m else 30 * 60 * 1000
        mins = max(15, round(ms / 60000))
        mins = min(mins, 24 * 60)  # cap one day
        return "provider_quota_limit", "omp-go", mins, until_iso(minutes=mins)

    # Claude weekly/session limit (confirmed) — cooldown until the reset time
    if RESET_RE.search(e):
        minutes = 4 * 60  # fallback
        reset_until = None
        mt = RESET_TIME_RE.search(e)
        if mt:
            hh = int(re.match(r"(\d{1,2})", mt.group(1)).group(1)) % 12
            if mt.group(2).lower() == "pm":
                hh += 12
            mm = 0
            tmp = mt.group(1)
            if ":" in tmp:
                mm = int(tmp.split(":")[1])
            cand = now().astimezone(ICT).replace(hour=hh, minute=mm, second=0)
            if cand <= now().astimezone(ICT):
                cand += timedelta(days=1)
            cand = cand.astimezone(timezone.utc)
            reset_until = cand.strftime("%Y-%m-%dT%H:%M:%SZ")
            minutes = None
        return "provider_quota_limit", "claude", minutes, reset_until if reset_until else until_iso(minutes=minutes)

    # Codex / generic usage limit (confirmed for codex + claude wording)
    if re.search(r"\busage limit\b|UsageLimit", e, re.I):
        return "provider_quota_limit", "codex", 60, until_iso(minutes=60)

    # Pi upstream 429 (confirmed, short cooldown)
    if "429" in e and ("rate_limit" in e or "rate limit" in e.lower()):
        return "provider_rate_limit", "pi-beam-free", 30, until_iso(minutes=30)

    # NEVER-cooldown classes
    if "429" in e:
        return "provider_rate_limit", None, None, None
    if re.search(r"\b401\b|Unauthorized|Incorrect API key", e):
        return "config_error", None, None, None
    if "idle watchdog" in e.lower():
        return "startup", None, None, None
    if e.lower() == "cancelled":
        return "cancelled", None, None, None
    if "codebuddy" in e.lower():
        return "unknown", "codebuddy", None, None
    if "freebuff" in e.lower():
        return "unknown", "freebuff", None, None
    return "other", None, None, None


