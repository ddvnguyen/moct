def read_ledger():
    d = sh_json(["multica", "issue", "metadata", "get", M86_ID, "--key", LEDGER_KEY])
    if isinstance(d, dict) and "__error__" in d:
        return None, d["__error__"]
    val = d.get("value") if isinstance(d, dict) else d
    if val in (None, ""):
        return None, "absent"
    try:
        return (json.loads(val) if isinstance(val, str) else val), None
    except json.JSONDecodeError as e:
        return None, f"bad json in {LEDGER_KEY}: {e}"

def read_seats():
    """M-86 `quota_seats` ({lead:[agent ids], architect:[agent ids]}) or None.
    Lets the Leader reorder committee pools without touching this script."""
    d = sh_json(["multica", "issue", "metadata", "get", M86_ID, "--key", SEATS_KEY])
    if isinstance(d, dict) and "__error__" in d:
        return None
    val = d.get("value") if isinstance(d, dict) else d
    if val in (None, ""):
        return None
    try:
        seats = json.loads(val) if isinstance(val, str) else val
    except json.JSONDecodeError:
        return None
    if not isinstance(seats, dict):
        return None
    out = {}
    for seat in ("lead", "architect"):
        ids = seats.get(seat)
        if isinstance(ids, list) and ids and all(isinstance(x, str) for x in ids):
            out[seat] = ids
    return out or None


