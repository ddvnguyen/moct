def agent_names():
    d = sh_json(["multica", "agent", "list", "--output", "json"])
    if isinstance(d, list):
        d = {"agents": d}
    out = {}
    rows = d.get("agents", []) if isinstance(d, dict) else []
    for a in rows:
        if a.get("id"):
            out[a["id"]] = {"name": a.get("name"), "model": a.get("model"), "status": a.get("status")}
    return out


def fetch_issues():
    # One call per status: a single list caps at 50 rows and the managed board
    # (in_progress + gate-waiting + assigned todos + blocked for the M-268
    # stuck-list) can exceed that. Still cheap: 4 list calls for the sweep.
    issues, seen, errors = [], set(), []
    for st in ("in_progress", "planing_2", "todo", "blocked"):
        d = sh_json(["multica", "issue", "list", "--output", "json", "--status", st,
                     "--fields", "identifier,id,status,assignee_id,updated_at,last_activity_at,priority,title"])
        if isinstance(d, dict) and "__error__" in d:
            errors.append({"status": st, "error": d["__error__"]})
            continue
        rows = d if isinstance(d, list) else d.get("issues", [])
        for i in rows:
            if i.get("id") not in seen:
                seen.add(i.get("id"))
                issues.append(i)
    return {"issues": issues, "has_more": False, "errors": errors}


