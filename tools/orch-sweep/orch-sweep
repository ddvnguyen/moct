def fetch_issues():
    # One call per status: a single list caps at 50 rows and the managed board
    # (in_progress + gate-waiting + assigned todos + blocked for the M-268
    # stuck-list) can exceed that. Still cheap: 4 list calls for the sweep.
    issues, seen = [], set()
    for st in ("in_progress", "planing_2", "todo", "blocked"):
        d = sh_json(["multica", "issue", "list", "--output", "json", "--status", st,
                     "--fields", "identifier,id,status,assignee_id,updated_at,last_activity_at,priority,title"])
        rows = d if isinstance(d, list) else d.get("issues", [])
        for i in rows:
            if i.get("id") not in seen:
                seen.add(i.get("id"))
                issues.append(i)
    return {"issues": issues, "has_more": False}


