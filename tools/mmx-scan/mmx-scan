def git(repo, *args, check=True):
    p = subprocess.run(["git", "-C", repo] + list(args), capture_output=True, text=True)
    if check and p.returncode != 0:
        sys.exit(f"mmx-scan: git {' '.join(args)} failed: {p.stderr.strip()}")
    return p.stdout.strip()


def commit_if_changed(repo, path, msg):
    path = os.path.relpath(os.path.abspath(path), os.path.abspath(repo))
    git(repo, "add", "-A", "--", path)
    if subprocess.run(["git", "-C", repo, "diff", "--cached", "--quiet", "--", path]).returncode == 0:
        return False
    git(repo, "commit", "-q", "-m", msg, "--", path)
    return True


PROTECTED_BRANCHES = {"integration", "master", "main", "stable"}


def guard_destination(repo, push):
    """Data never lands on a code branch or in a public repo (M-608 review, Owner decision)."""
    cur = git(repo, "symbolic-ref", "--short", "-q", "HEAD", check=False)
    for name, what in ((cur, "checkout branch"), (push, "--push target")):
        if name and name in PROTECTED_BRANCHES:
            sys.exit(f"mmx-scan: refusing: {what} is `{name}`; MMX data goes to a data branch (e.g. mmx-harness)")
    if push:
        url = git(repo, "remote", "get-url", "origin")
        p = subprocess.run(["gh", "repo", "view", url, "--json", "isPrivate", "-q", ".isPrivate"],
                           capture_output=True, text=True)
        if p.stdout.strip() != "true":
            sys.exit(f"mmx-scan: refusing to push: origin {url} is not a private repo "
                     f"(the export holds agent instructions and Workspace Context)")


def nightly(a):
    """Export the incumbent, commit it, then snapshot each missing day against that commit."""
    guard_destination(a.repo, a.push)
    repo, base = a.repo, os.path.join(a.repo, a.dir)
    inc, met = os.path.join(base, "incumbent"), os.path.join(base, "metrics")
    today = datetime.now(timezone.utc).date()
    a.out = inc
    export(a)
    changed = commit_if_changed(repo, inc, f"mmx-harness: incumbent {today.isoformat()}")
    sha = git(repo, "log", "-1", "--format=%H", "--", os.path.relpath(inc, repo)) or git(repo, "rev-parse", "HEAD")
    days = []
    start = datetime.fromisoformat(a.backfill_from).date() if a.backfill_from else today - timedelta(days=1)
    d = start
    while d < today:
        if a.force or not os.path.exists(os.path.join(met, f"{d.isoformat()}.jsonl")):
            days.append(d.isoformat())
        d += timedelta(days=1)
    for day in days[-a.max_days:]:
        write_jsonl(os.path.join(met, f"{day}.jsonl"), snapshot_day(day, sha, a.curator_agent))
    if days:
        commit_if_changed(repo, met, f"mmx-harness: metrics {', '.join(days[-a.max_days:])} (harness {sha[:10]})")
    if a.push:
        git(repo, "push", "-q", "origin", f"HEAD:{a.push}")
    print(json.dumps({"incumbent_changed": changed, "harness_commit": sha, "snapshot_days": days[-a.max_days:],
                      "head": git(repo, "rev-parse", "HEAD"), "pushed": a.push or None}))


# --- compare: the acceptance rule as a calculation ---------------------------

METRICS = {
    # name: (numerator keys, denominator keys, lower_is_better)
    "correction_rate": (("corrected_cards",), ("cards_in_review",), True),
    "request_changes_per_pr": (("request_changes",), ("prs_opened",), True),
    "tokens_per_card": (("tokens_input", "tokens_output", "tokens_cache_write"), ("cards_in_review",), True),
    "days_in_review": (("days_in_review_sum",), ("done_cards",), True),
    "failed_run_rate": (("failed", "blocked"), ("runs",), True),
    "resume_rate": (("resumes",), ("runs",), True),
    "asks_per_run": (("asks",), ("completed",), True),
    "mmx_share": (("mmx_runs",), ("completed",), False),
    "memory_calls_per_run": (("memory_search", "memory_get", "memory_note"), ("completed",), False),
    "harness_edit_per_run": (("harness_edit",), ("completed",), False),
}


def load_metrics(d):
    rows = []
    for f in sorted(os.listdir(d)):
        if f.endswith(".jsonl"):
            with open(os.path.join(d, f)) as fh:
                rows += [json.loads(line) for line in fh if line.strip()]
    return rows


def pooled(rows, metric):
    num, den, _ = METRICS[metric]
    n = sum(r.get(k, 0) or 0 for r in rows for k in num)
    dd = sum(r.get(k, 0) or 0 for r in rows for k in den)
    return (n / dd) if dd else None


def evaluate(rows, metric, canary, start, before_days=14, after_end=None, iters=2000, seed=7):
    """Effect of an edit started on `start` and its noise band δ.

    canary = list of agent names/ids, or [] for an L0/global edit (before/after on all
    agents). With canaries the effect is difference-in-differences against the
    other agents. δ = 95th percentile of |effect| under placebo splits of the
    `before_days` baseline (day-level bootstrap), so an effect is real only if
    it exceeds what baseline noise alone produces.
    """
    import random
    agent_rows = [r for r in rows if r["agent"] != WORKSPACE_ROW]
    s = datetime.fromisoformat(start).date()
    b0 = (s - timedelta(days=before_days)).isoformat()
    before = [r for r in agent_rows if b0 <= r["date"] < start]
    after = [r for r in agent_rows if r["date"] >= start and (not after_end or r["date"] <= after_end)]
    is_c = (lambda r: r["agent"] in canary or r["agent_id"] in canary) if canary else (lambda r: True)

    def stat(bef, aft):
        if not canary:
            x, y = pooled(bef, metric), pooled(aft, metric)
            return None if x is None or y is None else y - x
        parts = [pooled([r for r in g if is_c(r) == want], metric) for g in (bef, aft) for want in (True, False)]
        if None in parts:
            return None
        cb, kb, ca, ka = parts
        return (ca - cb) - (ka - kb)

    effect = stat(before, after)
    days_b = sorted({r["date"] for r in before})
    by_day = defaultdict(list)
    for r in before:
        by_day[r["date"]].append(r)
    n_after = len({r["date"] for r in after})
    rnd = random.Random(seed)
    placebo = []
    if days_b and n_after:
        for _ in range(iters):
            p1 = [x for d in rnd.choices(days_b, k=len(days_b)) for x in by_day[d]]
            p2 = [x for d in rnd.choices(days_b, k=n_after) for x in by_day[d]]
            v = stat(p1, p2)
            if v is not None:
                placebo.append(abs(v))
    placebo.sort()
    delta = placebo[int(0.95 * (len(placebo) - 1))] if placebo else None

    def arm(rs, want):
        sel = [r for r in rs if not canary or is_c(r) == want]
        return {"days": len({r["date"] for r in sel}), "cards": sum(r.get("cards_in_review", 0) for r in sel),
                "value": pooled(sel, metric)}
    arms = {"canary_before": arm(before, True), "canary_after": arm(after, True)}
    if canary:
        arms.update({"control_before": arm(before, False), "control_after": arm(after, False)})
    return {"metric": metric, "effect": effect, "delta": delta, "arms": arms,
            "baseline_days": len(days_b), "lower_is_better": METRICS[metric][2]}


def compare(a):
    rows = load_metrics(a.metrics)
    canary = [x.strip() for x in a.canary.split(",") if x.strip()] if a.canary else []
    target = evaluate(rows, a.target, canary, a.start, a.baseline_days, a.end)
    guards = [evaluate(rows, g, canary, a.start, a.baseline_days, a.end) for g in a.guards.split(",") if g]
    reasons = []
    for k, v in target["arms"].items():
        if k.endswith("after") and (v["days"] < 7 or v["cards"] < 10):
            reasons.append(f"{k}: {v['days']} days / {v['cards']} cards (< 7 days or < 10 cards)")
    if target["baseline_days"] < 14:
        reasons.append(f"baseline has {target['baseline_days']} days (< 14)")

    def better(e):
        if e["effect"] is None or e["delta"] is None:
            return None
        gain = -e["effect"] if e["lower_is_better"] else e["effect"]
        return gain > e["delta"], gain < -e["delta"]
    t = better(target)
    if reasons or t is None:
        verdict = "insufficient-data"
    elif not t[0]:
        verdict = "revert"
        reasons.append(f"target gain within or below δ ({target['effect']} vs δ {target['delta']})")
    else:
        verdict = "adopt"
    for g in guards:
        gb = better(g)
        if gb and gb[1]:
            verdict = "revert" if verdict != "insufficient-data" else verdict
            reasons.append(f"guard {g['metric']} worse by more than δ ({g['effect']} vs δ {g['delta']})")
    out = {"edit_start": a.start, "canary": canary or "all (before/after)", "target": target,
           "guards": guards, "suggested_verdict": verdict, "reasons": reasons,
           "note": "Suggestion only. Claude Architect decides and also checks tokens_added is paid for."}
    print(json.dumps(out, indent=1))


# --- chart: weekly loop view -------------------------------------------------

def harness_edit_cards():
    out, off = [], 0
    while True:
        page, _ = cli(["issue", "list", "--metadata", "kind=harness-edit", "--limit", "100",
                       "--offset", str(off), "--output", "json",
                       "--fields", "id,identifier,status,metadata,created_at"], allow_fail=True)
        batch = (page.get("issues", []) if isinstance(page, dict) else page) or []
        out += batch
        if not (isinstance(page, dict) and page.get("has_more")) or not batch:
            return out
        off += len(batch)


def week_of(day):
    d = datetime.fromisoformat(day[:10]).date()
    return (d - timedelta(days=d.weekday())).isoformat()


def chart(a):
    rows = [r for r in load_metrics(a.metrics) if r["agent"] != WORKSPACE_ROW]
    weeks = defaultdict(list)
    for r in rows:
        weeks[week_of(r["date"])].append(r)
    ks = sorted(weeks)[-a.weeks:]
    corr = [pooled(weeks[w], "correction_rate") for w in ks]
    tok = [pooled(weeks[w], "tokens_per_card") for w in ks]
    edits = Counter()
    for c in harness_edit_cards():
        v = str((c.get("metadata") or {}).get("verdict") or "").lower()
        if v in ("adopted", "reverted", "falsified"):
            edits[(week_of(c.get("created_at") or "1970-01-01"), "adopted" if v == "adopted" else "reverted")] += 1
    fmt = lambda xs, f: "[" + ", ".join(f(x) if x is not None else "0" for x in xs) + "]"
    lab = "[" + ", ".join(f'"{w[5:]}"' for w in ks) + "]"
    lines = ["### MMX loop: is it improving?", "",
             "```mermaid", "xychart-beta", '  title "Owner-correction rate per card reaching in_review"',
             f"  x-axis {lab}", '  y-axis "corrected / delivered"',
             f"  line {fmt(corr, lambda x: f'{x:.3f}')}", "```", "",
             "```mermaid", "xychart-beta", '  title "Tokens per card reaching in_review (k, excl. cache reads)"',
             f"  x-axis {lab}", '  y-axis "k tokens"',
             f"  bar {fmt(tok, lambda x: f'{x / 1000:.0f}')}", "```", "",
             "| Week | delivered cards | corrected | correction rate | k tokens/card | edits adopted | reverted |",
             "|---|---|---|---|---|---|---|"]
    for w, c, t in zip(ks, corr, tok):
        rs = weeks[w]
        lines.append(f"| {w} | {sum(r['cards_in_review'] for r in rs)} | {sum(r['corrected_cards'] for r in rs)} | "
                     f"{'-' if c is None else f'{c:.2f}'} | {'-' if t is None else f'{t / 1000:.0f}'} | "
                     f"{edits[(w, 'adopted')]} | {edits[(w, 'reverted')]} |")
    lines += ["", "Improving = correction rate falls while tokens per card does not rise."]
    print("\n".join(lines))

# ---------------------------------------------------------------------------
# M-612: SIM ledger — one JSON file per problem, attempt and verdict (M-571 §§3,4,7).
# Files are immutable: each is written once and never rewritten. A verdict is a
# separate `A-<round>-<n>.verdict.json` file, written once the gate judges it.
# `INDEX.json` is generated by `sim index` and never edited by hand.
# The data lives in Knowledge_Documents (Owner, M-608): sim/problems/,
# sim/attempts/, sim/INDEX.json. moct is public.
# ---------------------------------------------------------------------------

SIM_SCHEMA = 1
SIM_COMPONENTS = ("owner_corrections_per_card", "tokens_per_card", "days_in_review")
# Mapping from the gate's abstract components to snapshot derived metrics.
GATE_METRICS = {"owner_corrections_per_card": "correction_rate",
                "tokens_per_card": "tokens_per_card",
                "days_in_review": "days_in_review"}
SIM_PROBLEM_RE = re.compile(r"^P-(\d+)\.json$")
SIM_ATTEMPT_RE = re.compile(r"^A-(\d+)-(\d+)\.json$")


def sim_root(a):
    """The sim/ dir: --sim DIR, else <data checkout>/<sim dir>; never the cwd by accident."""
    if getattr(a, "sim", None):
        return a.sim
    repo = getattr(a, "repo", None)
    if repo:
        return os.path.join(repo, getattr(a, "sim_dir", "sim"))
    sys.exit("mmx-scan sim: need --sim DIR (or --repo for data-side commands)")


def _sim_read(path):
    with open(path) as f:
        return json.load(f)


def _sim_write_new(path, obj):
    """Write one immutable SIM file; refuse to overwrite (concurrent writers conflict loudly)."""
    if os.path.exists(path):
        sys.exit(f"mmx-scan sim: {path} already exists; SIM files are immutable and written once")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(obj, f, indent=1, sort_keys=True, ensure_ascii=False)
        f.write("\n")
    print(f"mmx-scan: wrote {path}", file=sys.stderr)


def sim_next_id(problems_dir, attempts_dir, kind, rnd=None):
    """Next free P-<n> or A-<round>-<n> id by scanning existing files (no counter file)."""
    if kind == "problem":
        seen = {int(m.group(1)) for f in os.listdir(problems_dir) if os.path.isdir(problems_dir)
                and (m := SIM_PROBLEM_RE.match(f))} if os.path.isdir(problems_dir) else set()
        return f"P-{max(seen, default=0) + 1}"
    seen = {int(m.group(2)) for f in os.listdir(attempts_dir) if os.path.isdir(attempts_dir)
            and (m := SIM_ATTEMPT_RE.match(f)) and int(m.group(1)) == rnd} \
        if os.path.isdir(attempts_dir) else set()
    return f"A-{rnd}-{max(seen, default=0) + 1}"


def sim_problem(a):
    """Record one SIM problem: `sim new-problem --sim DIR --name .. --root-cause .. [--round N]`.

    The file is written once. `attempt_ids` holds the attempts known at creation
    (empty for seeded problems); the live problem→attempts link is derived by
    scanning attempt files (`problem_id`), so later attempts never rewrite it."""
    root = sim_root(a)
    pdir, adir = os.path.join(root, "problems"), os.path.join(root, "attempts")
    pid = sim_next_id(pdir, adir, "problem")
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    _sim_write_new(os.path.join(pdir, f"{pid}.json"),
                   {"schema": SIM_SCHEMA, "id": pid, "name": a.name, "root_cause": a.root_cause,
                    "opened_round": a.round, "status": "open", "attempt_ids": [], "created_at": now})


def sim_close_problem(a):
    """Close a problem without rewriting it: writes an immutable `P-<n>.closed.json`
    marker (`reason`, `round`). The index reports the problem as closed."""
    root = sim_root(a)
    pdir = os.path.join(root, "problems")
    if not os.path.exists(os.path.join(pdir, f"{a.problem}.json")):
        sys.exit(f"mmx-scan sim: unknown problem {a.problem}")
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    _sim_write_new(os.path.join(pdir, f"{a.problem}.closed.json"),
                   {"schema": SIM_SCHEMA, "problem_id": a.problem, "status": "closed",
                    "reason": a.reason, "round": a.round, "closed_at": now})


def sim_attempts_by_problem(adir):
    """Authoritative problem→attempts link, derived from attempt files (problem files
    are immutable and never gain later attempt ids)."""
    out = defaultdict(list)
    if not os.path.isdir(adir):
        return out
    for f in sorted(os.listdir(adir)):
        if not SIM_ATTEMPT_RE.match(f) or f.endswith(".verdict.json"):
            continue
        t = _sim_read(os.path.join(adir, f))
        out[t.get("problem_id")].append(t["id"])
    return out


def sim_problem_status(pdir, pid, prob):
    if os.path.exists(os.path.join(pdir, f"{pid}.closed.json")):
        return "closed"
    return prob.get("status", "open")


def sim_attempt(a):
    """Record one harness-edit attempt: `sim new-attempt --sim DIR --round N --problem P-n
    --layer L4 --component mmx --what .. --rationale .. --predicted-metric .. --predicted-delta .. [...]`.

    Adoption time is recorded here (all-agent rollout, M-571 §7). Refuses a second
    live attempt on the same component (at most one live edit per component)."""
    root = sim_root(a)
    pdir, adir = os.path.join(root, "problems"), os.path.join(root, "attempts")
    ppath = os.path.join(pdir, f"{a.problem}.json")
    if not os.path.exists(ppath):
        sys.exit(f"mmx-scan sim: unknown problem {a.problem} (no {ppath})")
    for f in sorted(os.listdir(adir)) if os.path.isdir(adir) else []:
        if not SIM_ATTEMPT_RE.match(f) or f.endswith(".verdict.json"):
            continue
        prev = _sim_read(os.path.join(adir, f))
        if prev.get("component") == a.component and not os.path.exists(
                sim_verdict_path(adir, prev["id"])):
            sys.exit(f"mmx-scan sim: component {a.component} already has live attempt {prev['id']}; "
                     "judge it before adopting another")
    aid = sim_next_id(pdir, adir, "attempt", a.round)
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    preds = [p for p in (a.predicted_metric or "").split(",") if p] or None
    _sim_write_new(os.path.join(adir, f"{aid}.json"),
                   {"schema": SIM_SCHEMA, "id": aid, "round": a.round, "problem_id": a.problem,
                    "layer": a.layer, "component": a.component, "what": a.what,
                    "rationale": a.rationale,
                    "predicted": {"metric": (preds[0] if preds else None), "delta": a.predicted_delta},
                    "observed": None, "adopted_at": now, "harness_commit": a.harness_commit,
                    "provenance": {"agent": a.agent, "executor": a.executor, "model": a.model,
                                  "tier": a.tier},
                    "card": a.card})


def sim_verdict_path(adir, attempt_id):
    return os.path.join(adir, f"{attempt_id}.verdict.json")


def sim_index_data(root):
    """One row per problem and attempt (with its verdict when judged). Pure: reused by tests.

    The problem→attempts link is derived from attempt files (`problem_id`); the
    `attempt_ids` array inside a problem file is the creation-time snapshot only
    (problem files are immutable). Close markers (`P-<n>.closed.json`) override status."""
    pdir, adir = os.path.join(root, "problems"), os.path.join(root, "attempts")
    by_prob = sim_attempts_by_problem(adir)
    problems, attempts = [], []
    if os.path.isdir(pdir):
        for f in sorted(os.listdir(pdir)):
            m = SIM_PROBLEM_RE.match(f)
            if not m:
                continue
            p = _sim_read(os.path.join(pdir, f))
            aids = sorted(set(by_prob.get(p["id"], [])) | set(p.get("attempt_ids", [])))
            problems.append({"id": p["id"], "name": p.get("name"),
                             "status": sim_problem_status(pdir, p["id"], p),
                             "opened_round": p.get("opened_round"), "attempts": len(aids),
                             "attempt_ids": aids})
    if os.path.isdir(adir):
        for f in sorted(os.listdir(adir)):
            m = SIM_ATTEMPT_RE.match(f)
            if not m or f.endswith(".verdict.json"):
                continue
            t = _sim_read(os.path.join(adir, f))
            aid = t["id"]
            row = {"id": aid, "round": t.get("round"), "problem_id": t.get("problem_id"),
                   "layer": t.get("layer"), "component": t.get("component"),
                   "card": t.get("card"), "verdict": None}
            vpath = sim_verdict_path(adir, aid)
            if os.path.exists(vpath):
                v = _sim_read(vpath)
                row["verdict"] = v.get("verdict")
                row["composite_gain"] = v.get("composite_gain")
                row["decided_at"] = v.get("decided_at")
            attempts.append(row)
    live = [t["component"] for t in attempts if not t["verdict"]]
    return {"schema": SIM_SCHEMA, "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "problems": problems, "attempts": attempts, "live_components": sorted(set(live)),
            "open_problems": sum(1 for p in problems if p["status"] == "open")}


def sim_index(a):
    """Regenerate INDEX.json from the files (the only writer; never hand-edited)."""
    root = sim_root(a)
    data = sim_index_data(root)
    path = os.path.join(root, "INDEX.json")
    os.makedirs(root, exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=1, sort_keys=True, ensure_ascii=False)
        f.write("\n")
    bad = sim_check(root)
    print(json.dumps({"index": path, "problems": len(data["problems"]),
                      "attempts": len(data["attempts"]), "open_problems": data["open_problems"],
                      "issues": bad}, indent=1))
    if bad:
        sys.exit(1)


def sim_check(root):
    """Ledger integrity: every attempt links a known problem, verdict files match an
    attempt. Returns a list of issues."""
    pdir, adir = os.path.join(root, "problems"), os.path.join(root, "attempts")
    probs = {f[:-5] for f in os.listdir(pdir) if SIM_PROBLEM_RE.match(f)} \
        if os.path.isdir(pdir) else set()
    afiles = os.listdir(adir) if os.path.isdir(adir) else []
    bad = []
    for f in sorted(afiles):
        if f.endswith(".verdict.json"):
            if f[:-13] + ".json" not in afiles:
                bad.append(f"orphan verdict {f}")
            continue
        if not SIM_ATTEMPT_RE.match(f):
            continue
        t = _sim_read(os.path.join(adir, f))
        if t.get("problem_id") not in probs:
            bad.append(f"{f}: unknown problem {t.get('problem_id')}")
    return bad


def sim_read(a):
    """Proposer input: the index plus every open problem with all its attempts, in full
    (M-571 §3). Closed problems come through the index only, so the record can grow."""
    root = sim_root(a)
    idx = _sim_read(os.path.join(root, "INDEX.json")) if os.path.exists(
        os.path.join(root, "INDEX.json")) else sim_index_data(root)
    pdir, adir = os.path.join(root, "problems"), os.path.join(root, "attempts")
    by_prob = {p["id"]: p.get("attempt_ids", []) for p in idx.get("problems", [])}
    if "problems" not in idx and os.path.isdir(pdir):  # no index yet: every problem is open
        by_prob = {f[:-5]: [] for f in os.listdir(pdir) if SIM_PROBLEM_RE.match(f)}
    open_ids = [p["id"] for p in idx.get("problems", []) if p["status"] == "open"] \
        if "problems" in idx else sorted(by_prob)
    out = {"index": idx, "open_problems": []}
    for pid in open_ids:
        p = _sim_read(os.path.join(pdir, f"{pid}.json"))
        entry = {"problem": p, "attempts": []}
        for aid in by_prob.get(pid, []):
            t = _sim_read(os.path.join(adir, f"{aid}.json"))
            vpath = sim_verdict_path(adir, aid)
            entry["attempts"].append(
                {"attempt": t, "verdict": _sim_read(vpath) if os.path.exists(vpath) else None})
        out["open_problems"].append(entry)
    print(json.dumps(out, indent=1, ensure_ascii=False))


# --- composite gate: after window vs before window (M-571 §7) ------------------
# Rollout is all-agent, so there is no canary: each component is scored as a
# z-score against the 14 days before adoption, and the three are weighted equally.
# Non-compensatory pass rule (from RRSI): the composite must improve beyond its
# bootstrap noise band AND no single component may regress beyond its own band.


def gate_z(before_vals, after_val):
    """z-score of the after value against the before window (lower-is-better kept
    as signed z; the caller flips the sign into a gain). None when undefined."""
    xs = [x for x in before_vals if x is not None]
    if len(xs) < 2 or after_val is None:
        return None
    sd = statistics.pstdev(xs)
    if sd == 0:
        return 0.0 if after_val == xs[0] else (math.inf if after_val > xs[0] else -math.inf)
    return (after_val - statistics.fmean(xs)) / sd


def gate_bootstrap_band(before_vals, iters=2000, seed=7):
    """Noise band: 95th percentile of |z| of resampled before-days against the rest
    of the before window. Inside the band = noise, not signal."""
    import random
    xs = [x for x in before_vals if x is not None]
    if len(xs) < 3:
        return None
    rnd = random.Random(seed)
    zs = []
    for _ in range(iters):
        pick = rnd.randrange(len(xs))
        rest = xs[:pick] + xs[pick + 1:]
        z = gate_z(rest, xs[pick])
        if z is not None and math.isfinite(z):
            zs.append(abs(z))
    if not zs:
        return None
    zs.sort()
    return zs[int(0.95 * (len(zs) - 1))]


def gate_series(rows, metric, start, end):
    """Daily pooled values of `metric` for the before window (14 days pre-start)
    and the after window (start..end). Days with no denominator are skipped."""
    s = datetime.fromisoformat(start).date()
    b0 = (s - timedelta(days=14)).isoformat()
    per_day = defaultdict(list)
    for r in rows:
        if r["agent"] == WORKSPACE_ROW:
            continue
        per_day[r["date"]].append(r)
    def val(day_rows):
        return pooled(day_rows, metric)
    before = [val(per_day[d]) for d in sorted(per_day) if b0 <= d < start]
    after = ([val(per_day[d]) for d in sorted(per_day) if start <= d <= end]
             if end else [val(per_day[d]) for d in sorted(per_day) if d >= start])
    return [x for x in before if x is not None], ([x for x in after if x is not None])


def gate_judge(rows, start, end=None, components=SIM_COMPONENTS, iters=2000, seed=7,
               min_cards=10, max_days=14):
    """Judge one adopted edit. Pure function over snapshot rows (reused by tests)."""
    per_agent = defaultdict(list)
    for r in rows:
        if r["agent"] != WORKSPACE_ROW:
            per_agent[r["agent"]].append(r)
    after_days = {r["date"] for r in rows
                  if r["agent"] != WORKSPACE_ROW and r["date"] >= start
                  and (not end or r["date"] <= end)}
    after_cards = sum(r.get("cards_in_review", 0) or 0 for r in rows
                      if r["agent"] != WORKSPACE_ROW and r["date"] >= start
                      and (not end or r["date"] <= end))
    comp_rows, wobble, details = {}, {}, {}
    for comp in components:
        metric = GATE_METRICS[comp]
        before, after = gate_series(rows, metric, start, end)
        after_val = statistics.fmean(after) if after else None
        z = gate_z(before, after_val)
        band = gate_bootstrap_band(before, iters, seed)
        gain = None if z is None else -z  # all three components are lower-is-better
        comp_rows[comp] = {"metric": metric, "before_days": len(before),
                           "after_days": len(after_days), "before_mean": statistics.fmean(before)
                           if before else None, "after_mean": after_val, "z": z, "band": band,
                           "gain": gain}
        wobble[comp] = band
        details[comp] = {"before": before, "after_mean": after_val}
    gains = [comp_rows[c]["gain"] for c in components]
    composite = statistics.fmean(gains) if all(g is not None and math.isfinite(g) for g in gains) \
        else None
    comp_band = statistics.fmean([w for w in wobble.values() if w is not None]) \
        if any(w is not None for w in wobble.values()) else None
    per_agent_gain = {}
    for agent, rs in sorted(per_agent.items()):
        gs = []
        for comp in components:
            before, after = gate_series(rs, GATE_METRICS[comp], start, end)
            after_val = statistics.fmean(after) if after else None
            z = gate_z(before, after_val)
            gs.append(None if z is None else -z)
        per_agent_gain[agent] = statistics.fmean(gs) \
            if all(g is not None and math.isfinite(g) for g in gs) else None
    reasons = []
    if len(after_days) > max_days:
        reasons.append(f"after window {len(after_days)} days exceeds the {max_days}-day cap")
    if after_cards < min_cards:
        reasons.append(f"after window has {after_cards} cards (< {min_cards})")
    for comp in components:
        if comp_rows[comp]["before_days"] < 14:
            reasons.append(f"{comp}: before window has {comp_rows[comp]['before_days']} days (< 14)")
    early_regress = [c for c in components
                     if comp_rows[c]["gain"] is not None and comp_rows[c]["band"] is not None
                     and comp_rows[c]["gain"] < -comp_rows[c]["band"]]
    if reasons or composite is None or comp_band is None:
        verdict = "inconclusive"
    elif early_regress:
        verdict = "rejected"
        reasons.append("regressed beyond its band: " + ", ".join(early_regress))
    elif composite > comp_band:
        verdict = "kept"
    else:
        verdict = "inconclusive"
        reasons.append(f"composite {composite:.3f} inside noise band ±{comp_band:.3f}")
    # Non-compensatory check, reported even when the verdict is already decided.
    if verdict == "kept":
        for c in components:
            if comp_rows[c]["gain"] is not None and comp_rows[c]["band"] is not None \
                    and comp_rows[c]["gain"] < -comp_rows[c]["band"]:
                verdict = "rejected"
                reasons.append(f"guard {c} worse beyond its band "
                               f"({comp_rows[c]['gain']:.3f} < -{comp_rows[c]['band']:.3f})")
    return {"verdict": verdict, "composite_gain": composite, "composite_band": comp_band,
            "components": comp_rows, "per_agent_gain": per_agent_gain,
            "after_days": len(after_days), "after_cards": after_cards, "reasons": reasons}


def gate(a):
    """Score one live attempt: `gate --sim DIR --metrics DIR --attempt A-<r>-<n> [--end DAY]`.
    Prints the judgement; `--write` also stores the verdict file (immutable, once)."""
    root = sim_root(a)
    adir = os.path.join(root, "attempts")
    tpath = os.path.join(adir, f"{a.attempt}.json")
    if not os.path.exists(tpath):
        sys.exit(f"mmx-scan gate: unknown attempt {a.attempt} (no {tpath})")
    t = _sim_read(tpath)
    vpath = sim_verdict_path(adir, a.attempt)
    if os.path.exists(vpath) and not a.write:
        j = _sim_read(vpath)
        print(json.dumps({"attempt": a.attempt, "already_judged": j}, indent=1))
        return
    rows = load_metrics(a.metrics)
    start = a.start or t.get("adopted_at", "")[:10]
    judged = gate_judge(rows, start, a.end)
    out = {"attempt": a.attempt, "component": t.get("component"), "round": t.get("round"),
           "adopted": (t.get("adopted_at", "")[:10]), "start": start, "end": a.end, **judged}
    if a.write:
        now = datetime.now(timezone.utc).isoformat(timespec="seconds")
        _sim_write_new(vpath, {"schema": SIM_SCHEMA, "attempt_id": a.attempt,
                               "problem_id": t.get("problem_id"),
                               "verdict": judged["verdict"],
                               "composite_gain": judged["composite_gain"],
                               "composite_band": judged["composite_band"],
                               "components": judged["components"],
                               "per_agent_gain": judged["per_agent_gain"],
                               "after": {"days": judged["after_days"], "cards": judged["after_cards"]},
                               "reasons": judged["reasons"], "decided_at": now,
                               "decided_by": a.decided_by})
    print(json.dumps(out, indent=1))


# --- rounds: 10 runs, then +1 day, +1 day, then every 3 days (M-571 §4) ---------
# Each round arms the next as an issue wakeup on the curator card (`rounds arm`
# prints the exact command). No new cron. The sequence restarts when an agent's
# model or executor changes (metrics are no longer comparable with the old baseline).

ROUND_GAPS = (1, 1, 3)  # days after round 2, 3, 4+ respectively


def rounds_schedule(n_runs, first_round_date=None, now=None):
    """Pure schedule. Round 1 after 10 runs; rounds 2, 3 one day apart; then every
    3 days. Returns a list of ISO dates. `first_round_date` anchors round 1
    (default: today); before 10 runs the list is empty."""
    if n_runs < 10:
        return []
    base = datetime.fromisoformat(first_round_date).date() if first_round_date \
        else (now or datetime.now(timezone.utc)).date()
    days = [base]
    gap_idx = 0
    return days  # rounds 2+ are armed one at a time by `rounds arm`, not precomputed


def rounds_next(last_round_date, round_no, reset=False):
    """Next round date after round `round_no` held on `last_round_date` (ISO day).
    Round 2 and 3 come one day later, round 4+ every 3 days. A model/executor
    change resets the sequence (`reset=True` → next round is +1 day)."""
    last = datetime.fromisoformat(last_round_date).date()
    if reset or round_no < 3:
        gap = 1
    else:
        gap = 3
    return (last + timedelta(days=gap)).isoformat()


def rounds_arm(a):
    """Print (and with --issue, create) the wakeup arming the next round on the curator card.
    The Architect runs the round when the wakeup fires, then arms the next one."""
    nxt = rounds_next(a.last_round_date, a.round_no, a.reset)
    argv = ["issue", "wakeup", "create", a.issue or "<card>", "--kind", "at",
            "--at", f"{nxt}T01:00:00Z",
            "--instruction",
            f"MMX round {a.round_no + 1}: run mmx-scan sim read, propose at most 3 "
            f"edits (one live edit per component), then arm round {a.round_no + 2} "
            "with mmx-scan rounds arm"]
    if a.issue:
        p = subprocess.run([CLI] + argv, capture_output=True, text=True)
        if p.returncode != 0:
            sys.exit(f"mmx-scan rounds arm: wakeup failed: {p.stderr.strip()}")
        print(p.stdout.strip() or json.dumps({"next_round": nxt}))
    else:
        print(" ".join(shlex.quote(t) for t in [CLI] + argv))
    print(json.dumps({"round": a.round_no + 1, "date": nxt, "reset": a.reset}), file=sys.stderr)


def rounds_next_cli(a):
    """Print the next round date. Without a round held yet, readiness gates on 10 runs."""
    if not a.last_round_date:
        ready = rounds_schedule(a.runs, a.first_round_date)
        print(json.dumps({"round": 1 if ready else None, "date": ready[0].isoformat() if ready else None,
                          "ready": bool(ready), "runs": a.runs}))
        return
    print(json.dumps({"round": a.round_no + 1, "date": rounds_next(a.last_round_date, a.round_no, a.reset),
                      "reset": a.reset}))


