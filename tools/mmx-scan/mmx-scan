def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", (name or "").lower()).strip("-")


def day_bounds(day):
    since = datetime.fromisoformat(day).replace(tzinfo=timezone.utc)
    return since, since + timedelta(days=1)


def issues_touched_since(since, until):
    out, off = [], 0
    while True:
        page, _ = cli(["issue", "list", "--updated-since", since.isoformat(timespec="seconds"),
                       "--updated-until", until.isoformat(timespec="seconds"),
                       "--limit", "100", "--offset", str(off), "--output", "json",
                       "--fields", "id,identifier,title,status,assignee_type,assignee_id"])
        batch = page.get("issues", []) if isinstance(page, dict) else page
        out += batch
        if not (isinstance(page, dict) and page.get("has_more")) or not batch:
            return out
        off += len(batch)


def card_events(tl, since, until, assignee):
    """Replay one card's timeline; yield (kind, at, builder_agent_id, extra) for [since, until).

    builder = the agent that last moved the card FORWARD out of a working
    state (todo/planing_2/in_progress) into a delivered state — the agent whose
    delivery a later correction judges. Falls back to the current assignee.
    """
    events = sorted(tl, key=lambda e: e.get("created_at") or "")
    status, builder, entered_review = None, None, None
    for e in events:
        at = ts(e.get("created_at"))
        if not at:
            continue
        inside = since <= at < until
        b = builder or assignee
        if e.get("type") == "activity" and e.get("action") == "status_changed":
            d = e.get("details") or {}
            f, t = d.get("from"), d.get("to")
            if f in RANK and t in RANK and RANK[t] > RANK[f] and t in DELIVERED and \
                    RANK[f] <= RANK["in_progress"] and e.get("actor_type") == "agent":
                builder = e.get("actor_id")
                b = builder
            if inside:
                if t == "in_review" and f != "in_review":
                    yield "in_review", at, b, None
                if t == "done" and entered_review:
                    yield "done", at, b, (at - entered_review).total_seconds() / 86400
                if f in ("in_review", "done") and t in RANK and RANK[t] < RANK[f]:
                    yield "reopen", at, b, None
                elif f in RANK and t in RANK and RANK[t] < RANK[f]:
                    yield "sent_back", at, b, None
            if t == "in_review":
                entered_review = at
            status = t
        elif e.get("type") == "comment" and inside:
            body = e.get("content") or ""
            if e.get("actor_type") == "member" and status in DELIVERED and OWNER_CORRECTION_RE.search(body):
                yield "owner_correction", at, b, None
            elif e.get("actor_type") == "agent" and e.get("actor_id") != b and \
                    RC_VERDICT_RE.search(body[:600]):  # the builder quoting the verdict is not one
                yield "request_changes", at, b, None


def usage_tokens(issue_id):
    u, _ = cli(["issue", "usage", issue_id, "--output", "json"], allow_fail=True)
    u = u or {}
    return {"tokens_input": u.get("total_input_tokens", 0), "tokens_output": u.get("total_output_tokens", 0),
            "tokens_cache_read": u.get("total_cache_read_tokens", 0),
            "tokens_cache_write": u.get("total_cache_write_tokens", 0)}


def prs_opened(day, slugs):
    """PRs created on `day` in the workspace repos, attributed by head branch `agent/<slug>/`."""
    ws, _ = cli(["workspace", "get", "--output", "json"], allow_fail=True)
    repos = [r["url"].rstrip("/").split("github.com/")[-1] for r in (ws or {}).get("repos", [])]
    out = Counter()
    for repo in repos:
        p = subprocess.run(["gh", "pr", "list", "-R", repo, "--state", "all", "--limit", "200",
                            "--search", f"created:{day}", "--json", "headRefName"],
                           capture_output=True, text=True)
        if p.returncode != 0:
            continue
        for pr in json.loads(p.stdout or "[]"):
            m = re.match(r"agent/([^/]+)/", pr.get("headRefName", ""))
            if m and m.group(1) in slugs:
                out[slugs[m.group(1)]] += 1
    return out


def snapshot_day(day, harness_commit=None, curator_agent=CURATOR_AGENT):
    """One dict per agent with activity on `day` (UTC), plus a `_workspace` row."""
    since, until = day_bounds(day)
    names, runs = all_runs(since, until)
    rows = defaultdict(Counter)
    terminal = [t for t in runs if t["status"] in TERMINAL]
    with ThreadPoolExecutor(8) as ex:
        scans = dict(zip([t["id"] for t in terminal], ex.map(scan_messages, [t["id"] for t in terminal])))
    for t in runs:
        c = rows[t["agent_id"]]
        c["runs"] += 1
        if t["status"] in ("completed", "failed", "blocked", "cancelled"):
            c[t["status"]] += 1
        if RESUME_RE.search((t.get("handoff_note") or "") + (t.get("trigger_summary") or "")):
            c["resumes"] += 1
        if t["agent_id"] == curator_agent and t.get("kind") == "autopilot":
            c["curator_runs"] += 1
            continue  # the loop must not inflate its own usage metrics
        r = scans.get(t["id"])
        if not r:
            continue
        c["unreadable_runs"] += not r["ok"]
        c["mmx_runs"] += bool(r["mmx"]) and t["status"] == "completed"
        for k in ("memory_search", "memory_get", "memory_note", "harness_edit"):
            c[k] += r[k]
        c["asks"] += r["ask"]
    issues = issues_touched_since(since, datetime.now(timezone.utc))
    with ThreadPoolExecutor(8) as ex:
        tls = dict(zip([i["id"] for i in issues], ex.map(timeline, [i["id"] for i in issues])))
    review_cards, corrected = defaultdict(set), defaultdict(set)
    for i in issues:
        assignee = i.get("assignee_id") if i.get("assignee_type") == "agent" else None
        for kind, _at, b, extra in card_events(tls[i["id"]], since, until, assignee):
            if not b:
                continue
            c = rows[b]
            if kind == "in_review":
                review_cards[b].add(i["id"])
            elif kind == "done":
                c["done_cards"] += 1
                c["days_in_review_sum"] += round(extra, 3)
            elif kind == "reopen":
                c["reopens"] += 1
                corrected[b].add(i["id"])
            elif kind == "owner_correction":
                c["owner_correction_comments"] += 1
                corrected[b].add(i["id"])
            elif kind in ("sent_back", "request_changes"):
                c[kind] += 1
    for b, cards in review_cards.items():
        rows[b]["cards_in_review"] += len(cards)
        with ThreadPoolExecutor(8) as ex:
            for u in ex.map(usage_tokens, list(cards)):
                rows[b].update(u)
    for b, cards in corrected.items():
        rows[b]["corrected_cards"] += len(cards)
    for b, n in prs_opened(day, {slug(v): k for k, v in names.items()}).items():
        rows[b]["prs_opened"] += n
    team = moct_records("active", ["convention", "rule"], ["team"])
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    base = {"schema": SCHEMA, "date": day, "harness_commit": harness_commit, "measured_at": now}
    out = []
    tot = Counter()
    for aid in sorted(rows, key=lambda a: names.get(a, a)):
        c = rows[aid]
        tot.update(c)
        out.append({**base, "agent_id": aid, "agent": names.get(aid, aid[:8]),
                    **{k: c.get(k, 0) for k in COUNT_KEYS}})
    out.append({**base, "agent_id": None, "agent": WORKSPACE_ROW, **{k: tot.get(k, 0) for k in COUNT_KEYS},
                "active_team_rules": None if isinstance(team, dict) else len(team),
                "active_team_rules_as_of": now})
    return out


def write_jsonl(path, rows):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        for r in rows:
            f.write(json.dumps(r, sort_keys=True, ensure_ascii=False) + "\n")


def snapshot(a):
    rows = snapshot_day(a.date, a.harness_commit, a.curator_agent)
    if a.out:
        path = os.path.join(a.out, f"{a.date}.jsonl")
        write_jsonl(path, rows)
        print(f"mmx-scan: wrote {len(rows)} rows to {path}", file=sys.stderr)
    else:
        for r in rows:
            print(json.dumps(r, sort_keys=True, ensure_ascii=False))


