def redact(text):
    return SECRET_RE.sub("[REDACTED]", text or "")


def _write(root, rel, text):
    p = os.path.join(root, rel)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as f:
        f.write(redact(text).rstrip("\n") + "\n")


def export(a):
    """Write the portable harness (L1, L3, L4 + autopilot prompts) as plain files.

    Deterministic output, so an unchanged harness produces no git diff. Agent
    env, args and MCP config are never exported; secret-shaped strings are
    redacted. The tree is rebuilt from scratch so deletions show up as diffs.
    """
    root = a.out
    for sub in ("skills", "agents", "workspace", "autopilots"):
        shutil.rmtree(os.path.join(root, sub), ignore_errors=True)
    ws, _ = cli(["workspace", "get", "--output", "json"])
    _write(root, "workspace/context.md", ws.get("context") or "")
    skills, _ = cli(["skill", "list", "--output", "json"])
    for s in sorted(skills, key=lambda x: x["name"]):
        d, _ = cli(["skill", "get", s["id"], "--with-content", "--output", "json"])
        base = f"skills/{slug(d['name'])}"
        _write(root, f"{base}/SKILL.md", d.get("content") or "")
        for f in d.get("files") or []:
            rel = os.path.normpath(f.get("path") or "")
            if rel and not rel.startswith("..") and not os.path.isabs(rel) and f.get("content") is not None:
                _write(root, f"{base}/{rel}", f["content"])
        _write(root, f"{base}/meta.json", json.dumps(
            {"id": d["id"], "name": d["name"], "description": d.get("description"),
             "updated_at": d.get("updated_at")}, indent=1, sort_keys=True))
    skill_names = {s["id"]: s["name"] for s in skills}
    for ag in sorted(agents_full(), key=lambda x: x["name"]):
        base = f"agents/{slug(ag['name'])}"
        _write(root, f"{base}/instructions.md", ag.get("instructions") or "")
        meta = {k: ag.get(k) for k in ("id", "name", "description", "model", "role", "subtype",
                                       "implements_role_id", "runtime_mode", "thinking_level",
                                       "max_concurrent_tasks", "use_tiers", "tier_ids", "updated_at")}
        meta["skills"] = sorted(skill_names.get(x.get("id") if isinstance(x, dict) else x,
                                                (x.get("name") if isinstance(x, dict) else x))
                                for x in ag.get("skills") or [])
        _write(root, f"{base}/meta.json", json.dumps(meta, indent=1, sort_keys=True))
    aps, _ = cli(["autopilot", "list", "--output", "json"], allow_fail=True)
    aps = aps if isinstance(aps, list) else (aps or {}).get("autopilots", [])
    for ap in sorted(aps, key=lambda x: x.get("title") or ""):
        d, _ = cli(["autopilot", "get", ap["id"], "--output", "json"], allow_fail=True)
        if not d:
            continue
        p = d.get("autopilot", d)
        base = f"autopilots/{slug(p.get('title'))}"
        _write(root, f"{base}/prompt.md", p.get("description") or "")
        _write(root, f"{base}/meta.json", json.dumps(
            {"id": p.get("id"), "title": p.get("title"), "assignee_id": p.get("assignee_id"),
             "status": p.get("status"), "execution_mode": p.get("execution_mode"),
             "triggers": [{k: t.get(k) for k in ("kind", "cron_expression", "timezone", "enabled")}
                          for t in d.get("triggers") or []]}, indent=1, sort_keys=True))
    print(f"mmx-scan: exported harness to {root}", file=sys.stderr)


def agents_full():
    lst, _ = cli(["agent", "list", "--output", "json"])
    with ThreadPoolExecutor(8) as ex:
        return [d for d, _ in ex.map(lambda a: cli(["agent", "get", a["id"], "--output", "json"]), lst)]


