SCHEMA = 1
WORKSPACE_ROW = "_workspace"
RESUME_RE = re.compile(r"no live run and no live wakeup\. Resume the task now")
# Owner comment that corrects delivered work ("no, do X"). Heuristic; only
# counted while the card sits in agent_review_deploy/in_review/done.
OWNER_CORRECTION_RE = re.compile(
    r"(?:^|[\s>*])(?:no[,.!]|not what|wrong|instead\b|why (?:did|is|was|do|does)\b|how\?|"
    r"should not\b|shouldn'?t\b|don'?t\b|do not\b|stop\b|revert\b|reopen|that'?s not|this is not|"
    r"it not\b|isn'?t (?:done|working|right)|still (?:broken|wrong|not))", re.I)
DELIVERED = {"agent_review_deploy", "in_review", "done"}
# A review VERDICT of REQUEST_CHANGES, not a comment that lists it as a signal.
RC_VERDICT_RE = re.compile(r"\b(?:verdict|review)\b[^\n]{0,80}?\bREQUEST_CHANGES\b|"
                           r"(?:^|\n)[\s>*#_`]*REQUEST_CHANGES\b", re.I)
