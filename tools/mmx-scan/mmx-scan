    h.add_argument("--weeks", type=int, default=8)
    m = sub.add_parser("sim", help="SIM ledger: problems, attempts, verdicts, index, proposer read")
    m.add_argument("op", choices=["new-problem", "new-attempt", "index", "read"],
                   help="new-problem: one P-n.json; new-attempt: one A-<round>-<n>.json; "
                   "index: regenerate INDEX.json; read: proposer input (index + open problems in full)")
    m.add_argument("--sim", help="sim dir (problems/, attempts/, INDEX.json)")
    m.add_argument("--repo", help="data checkout; sim dir is <repo>/<sim-dir>")
    m.add_argument("--sim-dir", default="sim", help="folder inside --repo (default: sim)")
    m.add_argument("--name", help="new-problem: short problem name")
    m.add_argument("--root-cause", help="new-problem: root cause")
    m.add_argument("--round", type=int, help="new-problem: opening round; new-attempt: round number")
    m.add_argument("--problem", help="new-attempt: problem id (P-n)")
    m.add_argument("--layer", help="new-attempt: harness layer L0-L5")
    m.add_argument("--component", help="new-attempt: component (one live edit max)")
    m.add_argument("--what", help="new-attempt: what changed")
    m.add_argument("--rationale", help="new-attempt: why this helps")
    m.add_argument("--predicted-metric", default="", help="new-attempt: predicted metric (comma list)")
    m.add_argument("--predicted-delta", type=float, default=0.0, help="new-attempt: predicted delta")
    m.add_argument("--harness-commit", help="new-attempt: incumbent commit it changed")
    m.add_argument("--agent", help="new-attempt: proposing agent")
    m.add_argument("--executor", help="new-attempt: executor harness")
    m.add_argument("--model", help="new-attempt: model")
    m.add_argument("--tier", help="new-attempt: tier")
    m.add_argument("--card", help="new-attempt: tracking card (e.g. M-612)")
    t = sub.add_parser("gate", help="composite gate: judge one live attempt after vs before window")
    t.add_argument("--sim", help="sim dir")
    t.add_argument("--repo", help="data checkout; sim dir is <repo>/<sim-dir>")
    t.add_argument("--sim-dir", default="sim", help="folder inside --repo (default: sim)")
    t.add_argument("--metrics", required=True, help="metrics dir with <date>.jsonl files")
    t.add_argument("--attempt", required=True, help="attempt id (A-<round>-<n>)")
    t.add_argument("--end", help="last UTC day of the after window (default: all days since adoption)")
    t.add_argument("--start", help="first UTC day of the after window (default: adoption date; "
                   "tests shorten the window with this)")
    t.add_argument("--write", action="store_true", help="also store the verdict file (immutable, once)")
    t.add_argument("--decided-by", default="claude-architect", help="verdict author for --write")
    r = sub.add_parser("rounds", help="round scheduler: 10 runs, +1 day, +1 day, then every 3 days")
    r.add_argument("op", choices=["next", "arm"], help="next: print the next round date; arm: arm it as a wakeup")
    r.add_argument("--last-round-date", help="ISO day of the last round held")
    r.add_argument("--round-no", type=int, default=1, help="number of the last round held")
    r.add_argument("--runs", type=int, default=10, help="completed runs so far (round 1 needs 10)")
    r.add_argument("--first-round-date", help="next: anchor date for round 1 (default: today)")
    r.add_argument("--reset", action="store_true", help="model/executor changed: restart the 1/1/3 sequence")
    r.add_argument("--issue", help="arm: curator card id to wake (without it, print the command)")
    a = ap.parse_args()
    if a.mode == "sim":
        {"new-problem": sim_problem, "new-attempt": sim_attempt,
         "index": sim_index, "read": sim_read}[a.op](a)
    elif a.mode == "gate":
        gate(a)
    elif a.mode == "rounds":
        if a.op == "arm" and not a.last_round_date:
            ap.error("rounds arm needs --last-round-date")
        (rounds_arm if a.op == "arm" else rounds_next_cli)(a)
    else:
        {"baseline": baseline, "signals": signals, "snapshot": snapshot, "export": export,
         "nightly": nightly, "compare": compare, "chart": chart}[a.mode](a)


