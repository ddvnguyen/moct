# Lane z environment — committed, NON-SECRET config only.
# Secrets (DB password, JWT secret, dev code, PAT) live in the runtime env
# file LANE_RUNTIME_ENV (chmod 600, never committed). deploy.sh creates and
# maintains it. Re-sourcing rules: every path points at the workspace disk;
# nothing under /tmp or the root disk.

LANE=z
LANE_ROOT=/mnt/workspace/clouds/dsh-z
LANE_HOME=/mnt/workspace/clouds/dsh-z/data/home

# --- Postgres: the existing :5432 cluster (infra-postgres container, PG16) ---
# Additive only: role `multica_z` + database `multica_z`, nothing else is
# touched on the cluster. The password is generated once by deploy.sh and kept
# in LANE_RUNTIME_ENV; the committed DSN keeps a PASSWORD placeholder.
MULTICA_Z_DB_CONTAINER=infra-postgres
MULTICA_Z_DB_HOST=127.0.0.1
MULTICA_Z_DB_PORT=5432
MULTICA_Z_DB_NAME=multica_z
MULTICA_Z_DB_ROLE=multica_z
MULTICA_Z_DSN_TEMPLATE=postgres://multica_z:PASSWORD@127.0.0.1:5432/multica_z?sslmode=disable

# --- multica-be z (Go server built from multica-x @ MULTICA_X_REF) ---
# Self-contained release under LANE_ROOT/multica-be/releases/<sha> (binaries +
# migrations + the lane CLI binary). No `go` on the lane PATH: deploy.sh
# discovers a toolchain via MULTICA_GO, PATH, then
# /mnt/workspace/tmp/spike-tools/go-sdk/bin/go.
MULTICA_BE_Z_PORT=4390
# The Go server has no loopback default: build its listen address from this
# host plus MULTICA_BE_Z_PORT (MULTICA_BIND_HOST). Keep it loopback — combined
# with the lane's fixed dev verification code, anything that can reach the
# host could reach the lane API.
MULTICA_BE_Z_BIND_HOST=127.0.0.1
MULTICA_BE_Z_PUBLIC_URL=http://127.0.0.1:4390
MULTICA_X_REPO=https://github.com/ddvnguyen/multica-x
MULTICA_X_REF=multica-moct

# --- moct-be z (Paseo fleet backend, own Turso file) ---
MOCT_BE_Z_PORT=8310
MOCT_Z_ROOT=/mnt/workspace/clouds/moct-z
MOCT_Z_DB_PATH=/mnt/workspace/clouds/moct-z/data/fleet.db
MOCT_Z_STATE_DIR=/mnt/workspace/clouds/moct-z/data/state
MOCT_Z_BACKUP_DIR=/mnt/workspace/clouds/moct-z/data/backups
MOCT_REPO=https://github.com/ddvnguyen/moct
MOCT_REF=main

# --- lane-z daemon (separate CLI profile under LANE_HOME) ---
# The daemon runs with HOME=$LANE_HOME so its profile state
# ($LANE_HOME/.multica/profiles/z) and the dsh runtime profile
# ($LANE_HOME/.dsh/profiles/multica) both land in the lane, never in the live
# user home. DSH itself is the lane release CLI (see DSH_Z_DSH_BIN).
MULTICA_Z_PROFILE=z
MULTICA_Z_WORKSPACES_ROOT=/mnt/workspace/clouds/dsh-z/data/workspaces
MULTICA_Z_ADMIN_EMAIL=multica-z@ddvnguyen.com
MULTICA_Z_WS_SLUG=dsh-z

# Default model for lane agent runs (M-126/M-103): avoid falling back to the
# deepseek route on a re-provisioned workspace. Consumed via LANE_AGENT_DEFAULT_MODEL.
LANE_AGENT_DEFAULT_MODEL=opencode-go/beam-free

# MOCT seam (M-101, docs/moct-seam.md): non-empty writes MOCT_BASE_URL into
# the lane daemon env, which turns on the pre-run inject and the `moct` MCP
# overlay. Lane z runs moct-be on this loopback port, so the lane ships with
# the seam on; empty keeps it off (no block, no MCP entry, no warning).
LANE_MOCT_BASE_URL="http://127.0.0.1:${MOCT_BE_Z_PORT}"

# --- dsh runtime profile (optional) ---
# The lane daemon registers dsh only when $LANE_HOME/.dsh/profiles/multica
# names @multica-ai/dsh-runtime (same check as the daemon probe in
# server/internal/daemon/dsh_profile.go). The bridge package is not on any
# registry (multica#6936), so the bundle is a cloned source tree kept on the
# lane disk; `git clone https://github.com/multica-ai/dsh-multica-runtime`
# there once. Point this at that directory to have phase 9b install it.
DSH_Z_RUNTIME_BUNDLE=/mnt/workspace/clouds/dsh-z/bundles/dsh-multica-runtime

# dsh executable the lane uses, both for the phase-9b runtime install and as
# MULTICA_DSH_PATH in the daemon env. It must be the lane release CLI, not the
# user's nvm dsh: the runtime bundle's dsh-framework peers all demand
# >=0.2.1-rc.2 <0.3.0 and the nvm install here is 0.2.0-rc.2, so any install
# or launch probed through it is rejected. `dsh plugin` is driven from a
# shebang'd Node script directly, and envOrDefault probes MULTICA_DSH_PATH
# before the bare name, so the absolute path is pinned the way
# resolveAgentExecutablePath keeps it. Never repointed at anything dsh-x shares.
DSH_Z_DSH_BIN=/mnt/workspace/clouds/dsh-z/current/apps/cli/lib/bin.js

# --- lane web (E2) ---
# The web UI of the lane runs under its own user unit `dsh-z.service`: it owns
# port 3180 and predates this deploy (the pre-lane bootstrap that started the
# dsh z web). deploy.sh does not manage it unless DSH_Z_WEB_UNIT names it —
# when it does, phase 9c installs the Multica plugin row into the profile the
# unit boots, writes the unit's extra env (MULTICA_DSH_TOKEN) and its row
# patch, and phase 11 restarts the unit so a rerun actually reruns the web.
# Unset keeps the pre-E2 behavior: deploy only prints the commands.
DSH_Z_WEB_UNIT=dsh-z.service

# dsh plugin --profile web add takes a directory bundle built by
# build-plugin-bundle.sh from a checkout with node_modules. deploy.sh's phase
# 9c installs it; the row's lane values (serverUrl, workspace slug) are NOT
# baked into the bundle — deploy keeps them in the lane's own patch layer
# $LANE_ROOT/data/multica-row.yml, added to the unit's boot as a second
# --patch, so config changes never mutate a node_modules copy.
DSH_Z_PLUGIN_BUNDLE=/mnt/workspace/clouds/dsh-z/bundles/multica-dsh-plugin

# --- auto-deploy (M-151, pull-based CD) ---
# The user timer scripts/lane-z/autodeploy.sh polls the newest successful push
# run of CI on this branch and installs its artifacts. Nothing on lane z is
# reachable from CI: the host pulls.
AUTODEPLOY_REPO=ddvnguyen/multica-x
AUTODEPLOY_BRANCH=multica-moct
AUTODEPLOY_WORKFLOW=CI
# Where the scripted side keeps its own state.
AUTODEPLOY_BIN_DIR=/mnt/workspace/clouds/dsh-z/bin
AUTODEPLOY_LOG_DIR=/mnt/workspace/clouds/dsh-z/logs/autodeploy
AUTODEPLOY_BACKUP_DIR=/mnt/workspace/backups/dsh-z
# Retention. /mnt/workspace runs close to full: one release costs ~105 MB of
# downloaded artifacts plus ~60 MB installed, so the artifact dir is deleted
# after install and old releases/backups are pruned every run.
AUTODEPLOY_KEEP_RELEASES=5
AUTODEPLOY_BACKUP_KEEP_DAYS=7
AUTODEPLOY_MIN_FREE_GB=3
# Evidence delivery. This host holds the Owner's CLI token, so the lane must
# never comment itself: it writes latest.md and POSTs the "lane-z deploy
# reporter" autopilot's webhook, and that run posts under its own agent
# identity. The URL is a credential — a 0600 file, never the repo or a log.
AUTODEPLOY_REPORT_DIR=/mnt/workspace/clouds/dsh-z/logs/autodeploy
AUTODEPLOY_WEBHOOK_FILE=/mnt/workspace/clouds/dsh-z/data/autodeploy-webhook.url
AUTODEPLOY_WORKSPACE_ID=98a1c260-dc0a-469d-8f4f-27c35c5a56cb

# --- runtime env file (generated, 0600, never committed) ---
LANE_RUNTIME_ENV=/mnt/workspace/clouds/dsh-z/data/multica-z.env

# --- systemd user units (owned by this lane; nothing else is touched) ---
MULTICA_BE_Z_UNIT=multica-be-z.service
MOCT_BE_Z_UNIT=moct-backend-z.service
MULTICA_DAEMON_Z_UNIT=multica-daemon-z.service
